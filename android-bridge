#!/system/bin/sh
# PocketUFW Android UI boundary. ONE su process per user operation.
# Machine-readable output only; never interpret packet counters as threats.
# This script runs from the APK's private engine directory.
set -u

[ "$#" -ge 1 ] || exit 2
ACTION="$1"
# Optionally, a toggle states what its caller was showing: see below.
SHOWN=''
case "$ACTION" in
  toggle|toggle-restore)
    if [ "$#" -eq 2 ]; then
      case "$2" in ACTIVE|INACTIVE) SHOWN="$2"; shift ;; *) exit 2 ;; esac
    fi ;;
esac
case "$ACTION" in
  inspect|enable|disable|enable-restore|toggle|toggle-restore|boot-enable|boot-disable|vpn-refresh|reset-counters|counters|remove-partial|prepare-uninstall)
    [ "$#" -eq 1 ] || exit 2 ;;
  set-ports)
    [ "$#" -eq 4 ] || exit 2
    PORT4="$2"; PORT6="$3"; SCOPE="$4"
    case "$SCOPE" in experimental|committed) : ;; *) exit 2 ;; esac
    for port in "$PORT4" "$PORT6"; do
      case "$port" in
        none) : ;;
        0|0*|*[!0-9]*|'') exit 2 ;;
        *) [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || exit 2 ;;
      esac
    done ;;
  use-auto)
    [ "$#" -eq 1 ] || exit 2 ;;
  *) exit 2 ;;
esac
[ "$(id -u)" = 0 ] || { echo 'root=DENIED'; exit 3; }

case "$0" in
  */*) BASE=$(dirname "$0") ;;
  *) exit 2 ;;
esac
ENGINE="$BASE/pocketufw"
BOOT="$BASE/bootctl"
CONFIG="$BASE/udp-config"
[ -r "$ENGINE" ] && [ -r "$BOOT" ] && [ -r "$CONFIG" ] || exit 4

# Serialize the whole lifecycle, including boot files and final removal readback.
# FD 8 is inherited by nested scripts; FD 9 remains the engine snapshot lock.
# Keep this small block identical in pocketufw, android-bridge, bootctl and boot-service.
operation_lock="${POCKETUFW_LOCK:-/dev/.pocketufw.lock}.operation"
command -v flock >/dev/null 2>&1 || { echo 'pocketufw: lifecycle locking unavailable' >&2; exit 75; }
if [ "$(readlink /proc/$$/fd/8 2>/dev/null)" != "$operation_lock" ]; then
  [ ! -L "$operation_lock" ] || { echo 'pocketufw: unsafe lifecycle lock' >&2; exit 1; }
  ( umask 077; : >>"$operation_lock" && chmod 600 "$operation_lock" ) || exit 1
  exec 8>>"$operation_lock"
fi
operation_polls=0
while [ "$operation_polls" -le 150 ]; do
  operation_error=$(flock -n -x 8 8>&8 2>&1) && break
  if [ -n "$operation_error" ] || [ "$operation_polls" -eq 150 ]; then
    echo 'pocketufw: lifecycle lock unavailable or busy; recheck before retrying' >&2
    exit 75
  fi
  operation_polls=$((operation_polls + 1))
  sleep 0.1
done
# mksh closes descriptors above 2 for children unless they are passed explicitly.
sh() { command sh "$@" 8>&8; }

# Fast, read-only counter refresh. The engine itself verifies both families,
# their owned rules and hooks before reading kernel counters. Do not query
# boot status, saved UDP policy, or the verbose rules report for a button tap.
if [ "$ACTION" = counters ]; then
  snapshot=$(sh "$ENGINE" activity 2>/dev/null) || {
    echo 'error=Live kernel counters are unavailable; firewall rules were not changed.'
    exit 5
  }
  case "$snapshot" in
    'state=ACTIVE'*)
      printf 'root=GRANTED\n%s\n' "$snapshot"
      exit 0 ;;
    *)
      echo 'error=Firewall is not active or its policy could not be verified.'
      exit 5 ;;
  esac
fi

# A verified saved choice takes precedence over automatic Tailscale discovery.
# This is app-owned device-protected data, removed by Android on uninstall.
read_config() {
  policy=$(sh "$CONFIG" read 2>/dev/null) || return 1
  case "$policy" in
    mode=AUTOMATIC) MODE=AUTOMATIC; SAVED4=none; SAVED6=none ;;
    mode=COMMITTED*)
      MODE=COMMITTED
      SAVED4=$(printf '%s\n' "$policy" | sed -n 's/^udp4=//p')
      SAVED6=$(printf '%s\n' "$policy" | sed -n 's/^udp6=//p')
      [ -n "$SAVED4" ] && [ -n "$SAVED6" ] || return 1 ;;
    *) return 1 ;;
  esac
}

# Read-only helper; the engine verifies the live rule grammar and hooks first.
read_live_ports() {
  live_ports=$(sh "$ENGINE" get-ports 2>/dev/null) || return 1
  OLD4=$(printf '%s\n' "$live_ports" | sed -n 's/^udp4=//p')
  OLD6=$(printf '%s\n' "$live_ports" | sed -n 's/^udp6=//p')
  [ -n "$OLD4" ] && [ -n "$OLD6" ]
}

restore_config() {
  if [ "$ORIGINAL_MODE" = COMMITTED ]; then
    sh "$CONFIG" write "$ORIGINAL4" "$ORIGINAL6" >/dev/null 2>&1
  else
    sh "$CONFIG" clear >/dev/null 2>&1
  fi
}

# STALE means armed but running older copies, so for every decision it is
# ENABLED. The refresh happens at the final read below, and Kotlin never sees it.
read_boot_status() {
  boot_status=$(sh "$BOOT" status 2>/dev/null) || boot_status='boot=UNKNOWN'
  [ "$boot_status" != boot=STALE ] || boot_status='boot=ENABLED'
  printf '%s\n' "$boot_status"
}

outcome='NONE'
message=''
created_now=0
previous_boot='UNKNOWN'

# The Quick Settings tile must determine the *live* state before toggling.
# Never toggle from a remembered color or a missing/ambiguous kernel report.
case "$ACTION" in
  toggle|toggle-restore)
    requested="$ACTION"
    live=$(sh "$ENGINE" verify 2>/dev/null) || :
    # A tap on an out-of-date tile must not do the opposite of what it showed.
    if [ -n "$SHOWN" ] && [ "$live" != "$SHOWN" ]; then
      ACTION=inspect
      outcome='FAILED'
      message='Firewall state had changed, so nothing was toggled. Status updated.'
    else
      case "$live" in
        ACTIVE) ACTION=disable ;;
        INACTIVE)
          if [ "$requested" = toggle-restore ]; then ACTION=enable-restore
          else ACTION=enable; fi
          ;;
        *)
          ACTION=inspect
          outcome='FAILED'
          message='Cannot toggle: live firewall state is degraded or unknown. Open the app.'
          ;;
      esac
    fi
    ;;
  remove-partial)
    # Only a firewall that is partial right now may be removed by this request.
    live=$(sh "$ENGINE" verify 2>/dev/null) || :
    if [ "$live" = DEGRADED ]; then
      ACTION=disable
    else
      ACTION=inspect
      outcome='FAILED'
      message='Firewall state had changed, so nothing was removed. Status updated.'
    fi
    ;;
esac

case "$ACTION" in
  inspect) ;;
  enable|enable-restore)
    # The firewall must never depend on Tailscale or saved ports: those problems
    # can only withhold the UDP exceptions, and the user is told so.
    set -- enable
    enable_note=''
    if ! read_config; then
      enable_note='Firewall enabled without saved UDP exceptions because the saved settings could not be read.'
    elif [ "$MODE" = AUTOMATIC ]; then
      set -- "$@" --auto-tailscale
    else
      [ "$SAVED4" = none ] || set -- "$@" --tailscale-udp4 "$SAVED4"
      [ "$SAVED6" = none ] || set -- "$@" --tailscale-udp6 "$SAVED6"
    fi
    if enable_output=$(sh "$ENGINE" "$@" 2>/dev/null); then
      created_now=1
      case "$enable_output" in
        *tailscale_probe=FAILED*)
          enable_note='Firewall enabled. Tailscale ports could not be verified, so no VPN exception was added. Use Refresh Tailscale ports later.' ;;
      esac
      enabled=1
    elif [ "$(sh "$ENGINE" verify 2>/dev/null)" = ACTIVE ]; then
      # A concurrent request got there first. Those rules are not ours to roll back.
      enable_note='Firewall is already on.'
      enabled=1
    else
      enabled=0
    fi
    if [ "$enabled" -ne 1 ]; then
      outcome='FAILED'
      message='Cannot enable firewall. Check other rules or VPN configuration.'
    elif [ "$ACTION" = enable-restore ]; then
      if sh "$BOOT" enable >/dev/null 2>&1; then
        outcome='SUCCESS'
        message="${enable_note:-Firewall enabled; boot restoration resumed.}"
      else
        outcome='FAILED'
        message='Firewall enabled, but boot restoration could not be rearmed.'
      fi
    else
      outcome='SUCCESS'
      message="${enable_note:-Firewall enabled.}"
    fi
    ;;
  disable)
    # Remember whether the user opted into boot restoration so Kotlin can
    # honor that preference after a temporary tile or Home-switch OFF.
    previous_boot=$(read_boot_status)
    previous_boot=${previous_boot#boot=}
    # The off switch must also disarm any Magisk boot hook, except that a hook
    # path owned by another module is not ours to touch and must not keep the
    # firewall on.
    if [ "$previous_boot" != CONFLICT ] && ! sh "$BOOT" disable >/dev/null 2>&1; then
      outcome='FAILED'
      message='Boot restoration could not be disabled; firewall left unchanged.'
    elif sh "$ENGINE" disable >/dev/null 2>&1; then
      outcome='SUCCESS'
      if [ "$previous_boot" = CONFLICT ]; then
        message='Firewall disabled. Another module owns the boot hook path, so it was left alone.'
      else
        message='Firewall disabled; boot restoration removed.'
      fi
    else
      outcome='FAILED'
      message='Could not remove all firewall rules; inspect status.'
      # A refused removal, such as another operation holding the lock, changed no
      # rules, so the boot choice must not change either. bootctl arms only a
      # firewall it has verified, so a partial one stays disarmed.
      if [ "$previous_boot" = ENABLED ] && sh "$BOOT" enable >/dev/null 2>&1; then
        message='The firewall could not be turned off, so it stays on and boot restoration was kept. Try again.'
      fi
    fi
    ;;
  prepare-uninstall)
    previous_boot=$(read_boot_status)
    previous_boot=${previous_boot#boot=}
    # The order Off uses: boot restoration first, so an interruption can't bring
    # anything back later. Unlike Off, one failure doesn't stop the other. The user
    # asked for both to go, and the read-back below reports exactly what is left.
    sh "$BOOT" purge >/dev/null 2>&1 || :
    sh "$ENGINE" disable >/dev/null 2>&1 || :
    outcome='SUCCESS'
    ;;
  boot-enable)
    if sh "$BOOT" enable >/dev/null 2>&1; then
      outcome='SUCCESS'
      message='Magisk boot restoration enabled.'
    else
      outcome='FAILED'
      message='Cannot enable boot restoration. Ensure firewall is active.'
    fi
    ;;
  boot-disable)
    if sh "$BOOT" disable >/dev/null 2>&1; then
      outcome='SUCCESS'
      message='Boot restoration disabled; live firewall unchanged.'
    else
      outcome='FAILED'
      message='Could not remove the boot hook; inspect status.'
    fi
    ;;
  reset-counters)
    if sh "$ENGINE" reset-counters >/dev/null 2>&1; then
      outcome='SUCCESS'
      message='PocketUFW counters reset. Rules and VPN exceptions are unchanged.'
    else
      outcome='FAILED'
      message='Could not reset all counters. Existing firewall rules are unchanged.'
    fi
    ;;
  vpn-refresh)
    if ! read_config; then
      outcome='FAILED'
      message='Saved UDP policy is invalid; automatic refresh refused.'
    elif [ "$MODE" = COMMITTED ]; then
      outcome='FAILED'
      message='Committed UDP exceptions are active. Use the VPN UDP exceptions editor to change them or return to automatic detection.'
    elif refresh_output=$(sh "$ENGINE" refresh 2>/dev/null); then
      # The engine reports a result only after a successful refresh. Do not
      # claim a change if the listener ports were already installed.
      refresh_result=$(printf '%s\n' "$refresh_output" | sed -n 's/^refresh_result=//p')
      case "$refresh_result" in
        UNCHANGED)
          outcome='SUCCESS'
          message='Tailscale UDP exceptions already up to date. No changes needed.' ;;
        UPDATED)
          outcome='SUCCESS'
          message='Tailscale UDP exceptions updated.' ;;
        *)
          outcome='FAILED'
          message='VPN refresh result could not be verified; inspect firewall state.' ;;
      esac
    else
      outcome='FAILED'
      message='VPN exceptions could not be refreshed; inspect firewall state.'
      case "${refresh_output:-}" in
        *stale_exceptions=REMOVED*)
          message='New Tailscale listeners could not be verified. Proven-stale UDP exceptions were removed; other exceptions were kept. Recheck and retry refresh.' ;;
      esac
    fi
    ;;
  set-ports)
    if ! read_config || ! read_live_ports; then
      outcome='FAILED'
      message='Current firewall or saved configuration cannot be verified; no changes made.'
    else
      ORIGINAL_MODE="$MODE"; ORIGINAL4="$SAVED4"; ORIGINAL6="$SAVED6"
      if ! sh "$ENGINE" set-ports --udp4 "$PORT4" --udp6 "$PORT6" >/dev/null 2>&1; then
        outcome='FAILED'
        message='UDP update failed. Inspect the existing firewall exceptions.'
      elif [ "$SCOPE" = experimental ]; then
        outcome='SUCCESS'
        message='Experimental UDP exceptions applied only to live rules. Saved settings are unchanged.'
      elif ! sh "$CONFIG" write "$PORT4" "$PORT6" >/dev/null 2>&1; then
        sh "$ENGINE" set-ports --udp4 "$OLD4" --udp6 "$OLD6" >/dev/null 2>&1 || :
        outcome='FAILED'
        message='Could not save committed UDP exceptions; attempted to restore previous live ports.'
      else
        current_boot=$(read_boot_status)
        if [ "$current_boot" != boot=ENABLED ] && [ "$current_boot" != boot=DISABLED ] &&
           [ "$current_boot" != boot=UNSUPPORTED ]; then
          restore_config || :
          sh "$ENGINE" set-ports --udp4 "$OLD4" --udp6 "$OLD6" >/dev/null 2>&1 || :
          outcome='FAILED'
          message='Magisk boot state cannot be verified; committed configuration was rolled back.'
        elif [ "$current_boot" = boot=ENABLED ] && ! sh "$BOOT" enable >/dev/null 2>&1; then
          restore_config || :
          sh "$ENGINE" set-ports --udp4 "$OLD4" --udp6 "$OLD6" >/dev/null 2>&1 || :
          sh "$BOOT" enable >/dev/null 2>&1 || :
          outcome='FAILED'
          message='Boot snapshot could not be updated; rollback attempted. Inspect saved and live rules.'
        else
          outcome='SUCCESS'
          message='Committed UDP exceptions saved for future firewall sessions and Magisk restoration.'
        fi
      fi
    fi
    ;;
  use-auto)
    # Even an invalid regular saved file may be reset after a verified live
    # Tailscale refresh. Symlinks/unsafe files remain protected by udp-config.
    if ! read_live_ports; then
      outcome='FAILED'
      message='Current firewall or saved configuration cannot be verified; no changes made.'
    elif ! sh "$ENGINE" refresh >/dev/null 2>&1; then
      outcome='FAILED'
      message='Cannot verify automatic Tailscale listeners. Committed settings unchanged.'
    elif ! sh "$CONFIG" clear >/dev/null 2>&1; then
      sh "$ENGINE" set-ports --udp4 "$OLD4" --udp6 "$OLD6" >/dev/null 2>&1 || :
      outcome='FAILED'
      message='Could not clear committed UDP settings; prior live ports restoration attempted.'
    else
      outcome='SUCCESS'
      message='Automatic verified Tailscale detection restored; committed UDP settings cleared.'
    fi
    ;;
esac

# 'activity' verifies both kernel rule families before reading their counters.
# It also reports INACTIVE/DEGRADED. Do not run 'verify' a second time on
# every dashboard opening. Fall back to it only if counter collection fails.
snapshot=$(sh "$ENGINE" activity 2>/dev/null) || :
state=$(printf '%s\n' "$snapshot" | sed -n 's/^state=//p')
case "$state" in
  ACTIVE|INACTIVE|DEGRADED) : ;;
  *)
    state=$(sh "$ENGINE" verify 2>/dev/null) || :
    case "$state" in ACTIVE|INACTIVE|DEGRADED) : ;; *) state='UNKNOWN' ;; esac
    snapshot=''
    ;;
esac
boot=$(sh "$BOOT" status 2>/dev/null) || :
if [ "$boot" = boot=STALE ]; then
  if [ "$state" != ACTIVE ] || [ "$ACTION" = prepare-uninstall ]; then
    # Installing requires a verified firewall; the opt-in itself still stands.
    boot='boot=ENABLED'
  elif ! sh "$BOOT" enable >/dev/null 2>&1; then
    boot='boot=DEGRADED'
  else
    # Touches only root-owned boot files, never firewall rules.
    boot=$(sh "$BOOT" status 2>/dev/null) || :
    [ "$boot" != boot=STALE ] || boot='boot=DEGRADED'
  fi
fi
case "$boot" in
  boot=ENABLED|boot=DISABLED|boot=UNSUPPORTED|boot=DEGRADED|boot=CONFLICT) : ;;
  *) boot='boot=UNKNOWN' ;;
esac

# Removal is judged only by reading everything back, never by its commands'
# exit codes. Android's uninstall page opens only on removal=CLEAN.
removal=''
removal_left=''
removal_kept=''
if [ "$ACTION" = prepare-uninstall ]; then
  note_left() { removal_left="${removal_left:+$removal_left,}$1"; }
  kernel_report=$(sh "$ENGINE" residue 2>/dev/null) || kernel_report=''
  left4=$(printf '%s\n' "$kernel_report" | sed -n 's/^residue_ipv4=//p')
  left6=$(printf '%s\n' "$kernel_report" | sed -n 's/^residue_ipv6=//p')
  case "$left4" in 0) : ;; ''|*[!0-9]*) note_left ipv4_unverified ;; *) note_left ipv4_rules ;; esac
  case "$left6" in 0) : ;; ''|*[!0-9]*) note_left ipv6_unverified ;; *) note_left ipv6_rules ;; esac
  # Two independent readings have to agree before anything is called gone.
  if [ -z "$removal_left" ] && [ "$state" != INACTIVE ]; then note_left kernel_unverified; fi
  boot_report=$(sh "$BOOT" residue 2>/dev/null) || boot_report=''
  case "$boot_report" in
    boot_left=*)
      boot_left=$(printf '%s\n' "$boot_report" | sed -n 's/^boot_left=//p')
      removal_kept=$(printf '%s\n' "$boot_report" | sed -n 's/^boot_kept=//p')
      [ -z "$boot_left" ] || note_left "$boot_left" ;;
    *) note_left boot_unverified ;;
  esac
  if [ -z "$removal_left" ]; then
    removal=CLEAN
    outcome='SUCCESS'
    if [ -z "$removal_kept" ]; then
      message="PocketUFW's rules and boot files are gone. Tap Uninstall to finish."
    else
      message="PocketUFW's rules and boot files are gone. Another module owns a boot path, so it was left alone. Tap Uninstall to finish."
    fi
  else
    removal=INCOMPLETE
    outcome='FAILED'
    still=''
    for item in $(printf '%s' "$removal_left" | tr ',' ' '); do
      case "$item" in
        ipv4_rules) text='IPv4 rules' ;;
        ipv6_rules) text='IPv6 rules' ;;
        ipv4_unverified) text='IPv4 rules, which could not be read' ;;
        ipv6_unverified) text='IPv6 rules, which could not be read' ;;
        kernel_unverified) text='firewall state, which could not be verified' ;;
        boot_hook) text='Magisk boot hook' ;;
        boot_hook_stage) text='a partly installed boot hook' ;;
        boot_data) text='boot data folder' ;;
        *) text='boot files, which could not be read' ;;
      esac
      still="${still:+$still, }$text"
    done
    message="Couldn't confirm everything is gone. Still present: $still."
  fi
fi

# Never report a successful action without verifying its postcondition.
if [ "$outcome" = 'SUCCESS' ]; then
  case "$ACTION" in
    enable) [ "$state" = ACTIVE ] || outcome='FAILED' ;;
    enable-restore) [ "$state" = ACTIVE ] && [ "$boot" = boot=ENABLED ] || outcome='FAILED' ;;
    disable)
      if [ "$previous_boot" = CONFLICT ]; then
        [ "$state" = INACTIVE ] && [ "$boot" = boot=CONFLICT ] || outcome='FAILED'
      else
        # Without Magisk there is no hook to disarm, so status stays UNSUPPORTED.
        [ "$state" = INACTIVE ] && { [ "$boot" = boot=DISABLED ] || [ "$boot" = boot=UNSUPPORTED ]; } ||
          outcome='FAILED'
      fi ;;
    boot-enable) [ "$boot" = boot=ENABLED ] || outcome='FAILED' ;;
    boot-disable) [ "$boot" = boot=DISABLED ] || outcome='FAILED' ;;
    vpn-refresh|set-ports|use-auto|reset-counters) [ "$state" = ACTIVE ] || outcome='FAILED' ;;
  esac
  if [ "$outcome" = 'FAILED' ]; then
    message='Operation postcondition not verified; inspect firewall state.'
  fi
fi

# If enabling installed only some rules, perform the existing best-effort
# rollback, then re-audit. Never silently claim protection.
if [ "$ACTION" = enable ] && [ "$created_now" = 1 ] &&
   [ "$outcome" = FAILED ] && [ "$state" != ACTIVE ]; then
  sh "$ENGINE" disable >/dev/null 2>&1 || :
  snapshot=''
  state=$(sh "$ENGINE" verify 2>/dev/null) || :
  case "$state" in ACTIVE|INACTIVE|DEGRADED) : ;; *) state='UNKNOWN' ;; esac
fi

if ! read_config; then
  MODE=DEGRADED; SAVED4=none; SAVED6=none
fi
# Read-only, best-effort Android-managed VPN owner identification.
# This runs inside the root session already used for full dashboard inspection;
# counter refresh remains a separate fast path. The OS limits owner metadata
# for ordinary apps. Never infer ownership from merely installed packages.
# Dumpsys output varies by Android release, so absence/ambiguity is expected.
VPN_OWNER=''
VPN_IFACE=''
if command -v dumpsys >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
  vpn_lines=$(timeout 2 dumpsys connectivity 2>/dev/null | sed -n '/ni{VPN CONNECTED/p') || vpn_lines=''
  vpn_matches=$(printf '%s\n' "$vpn_lines" |
    sed -n 's/.*ni{VPN CONNECTED extra: VPN:\([A-Za-z0-9_.-]*\)}.*/\1/p' |
    sort -u) || vpn_matches=''
  case "$vpn_matches" in
    ''|*'
'*) : ;; # No recognized Android VPN, or multiple candidates: do not guess.
    *[!A-Za-z0-9_.-]*) : ;;
    *) VPN_OWNER=$vpn_matches ;;
  esac
  # Android's own record ties the owner to its interface, so this isn't a guess.
  if [ -n "$VPN_OWNER" ]; then
    vpn_ifaces=$(printf '%s\n' "$vpn_lines" |
      sed -n 's/.*InterfaceName: \([A-Za-z0-9_.-]*\)[ }].*/\1/p' |
      sort -u) || vpn_ifaces=''
    case "$vpn_ifaces" in
      ''|*'
'*) : ;;
      *) VPN_IFACE=$vpn_ifaces ;;
    esac
  fi
fi

# Read-only and best effort: interfaces that can receive traffic but that the
# wlan+, rmnet+ and v4-rmnet+ hooks do not filter. Loopback and dummy carry no
# inbound traffic. A VPN's tun is listed like its kernel and IPsec equivalents:
# traffic inside any of them really isn't filtered, and the user should be told.
# Only the engine's verified report can remove one from this list: with the optional
# tunnel filter on, a hooked tunnel is filtered. Anything else stays listed.
TUNNEL_HOOKS=$(printf '%s\n' "$snapshot" | sed -n 's/^tunnel_hooks=//p')
UNCOVERED_IFACES=''
if command -v ip >/dev/null 2>&1; then
  UNCOVERED_IFACES=$({ ip -o link 2>/dev/null; echo '--addresses--'; ip -o addr 2>/dev/null; } | awk -v hooks="$TUNNEL_HOOKS" '
    function hooked(name, i, pattern) {
      for (i = 1; i <= hook_count; i++) {
        pattern = hook[i]
        if (sub(/[+]$/, "", pattern)) { if (index(name, pattern) == 1) return 1 }
        else if (name == pattern) return 1
      }
      return 0
    }
    BEGIN { hook_count = split(hooks, hook, ",") }
    $0 == "--addresses--" { in_addresses = 1; next }
    !in_addresses {
      name = $2; sub(/:$/, "", name); sub(/@.*$/, "", name)
      if ($3 ~ /[<,]UP[,>]/) up[name] = 1
      next
    }
    $3 == "inet" || ($3 == "inet6" && / scope global /) {
      name = $2; sub(/:$/, "", name); sub(/@.*$/, "", name)
      if (!(name in up) || (name in listed)) next
      if (name == "lo" || name ~ /^(wlan|rmnet|v4-rmnet|dummy)/ || hooked(name)) next
      listed[name] = 1
      list = list (list == "" ? "" : ",") name
    }
    END { print list }
  ') || UNCOVERED_IFACES=''
fi

echo 'root=GRANTED'
echo "vpn_owner=$VPN_OWNER"
echo "vpn_iface=$VPN_IFACE"
echo "uncovered_ifaces=$UNCOVERED_IFACES"
echo "config_mode=$MODE"
echo "committed_udp4=$SAVED4"
echo "committed_udp6=$SAVED6"
echo "previous_boot=$previous_boot"
echo "operation=$outcome"
echo "message=$message"
echo "state=$state"
case "$state:$(printf '%s\n' "$snapshot" | sed -n 's/^tunnel_filter=//p')" in
  ACTIVE:ON) echo 'tunnel_filter=ON' ;;
  ACTIVE:OFF|INACTIVE:*) echo 'tunnel_filter=OFF' ;;
  *) echo 'tunnel_filter=UNKNOWN' ;;
esac
echo "$boot"
if [ "$ACTION" = prepare-uninstall ]; then
  echo "removal=$removal"
  echo "removal_left=$removal_left"
  echo "removal_kept=$removal_kept"
fi

if [ "$state" = ACTIVE ]; then
  # These counters were measured by the same verified 'activity' command.
  # A degraded or incomplete response must never become a fabricated zero.
  if [ -n "$snapshot" ]; then
    printf '%s\n' "$snapshot" | grep -E '^(ipv[46]_(tunnel_)?(blocked|blocked_bytes|established_replies)=[0-9]+|ipv[46]_tunnel_tailnet=[0-9]+)$' || :
  fi
fi

# Get an exact read-only snapshot of our live kernel rules in the SAME root
# session, even if a chain is degraded but still readable. A missing READY
# marker means the report is incomplete; Android must not present it as proof.
if [ "$state" = ACTIVE ] || [ "$state" = DEGRADED ]; then
  report=$(sh "$BASE/rules-report" 2>/dev/null) || report=''
  if [ "$(printf '%s\n' "$report" | tail -n 1)" = 'rules_report=READY' ]; then
    printf '%s\n' "$report"
  else
    echo 'rules_report=UNAVAILABLE'
  fi
fi
