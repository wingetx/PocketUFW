#!/system/bin/sh
# PocketUFW experimental Magisk boot restoration controller.
# Installs only PocketUFW-owned files under /data/adb/pocketufw and
# one nonblocking late_start hook under /data/adb/service.d.
set -eu
umask 077

STORE='/data/adb/pocketufw'
HOOK='/data/adb/service.d/pocketufw.sh'
MARKER="$STORE/boot.enabled"
SIGNATURE='# PocketUFW boot hook v1'
[ "$#" -ge 1 ] || { echo 'bootctl: command required' >&2; exit 1; }
CMD="$1"
SELF_DIR=$(dirname "$0")

say() { printf '%s\n' "$*"; }
fail() { say "pocketufw boot: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || fail 'root required'
case "$CMD" in status|enable|disable|purge|residue) : ;; *) fail 'use status, enable, disable, purge, or residue' ;; esac

case "$CMD" in enable|disable|purge)
# /proc/uptime is monotonic and includes suspend. Shell builtins avoid a process
# per clock read. Keep the two-part timestamp: mksh arithmetic is 32-bit on Android.
clock_now() {
  read -r clock_stamp clock_rest < "${POCKETUFW_UPTIME:-/proc/uptime}" || return 1
  clock_seconds=${clock_stamp%.*}; clock_fraction=${clock_stamp#*.}
  case "$clock_seconds" in ''|*[!0-9]*) return 1 ;; esac
  case "$clock_fraction" in [0-9][0-9]) ;; *) return 1 ;; esac
  clock_fraction=$((1$clock_fraction - 100))
}
start_deadline() {
  clock_now || { echo 'pocketufw: monotonic clock unavailable' >&2; exit 75; }
  wait_until=$((clock_seconds + $1)); wait_fraction=$clock_fraction
}
deadline_reached() {
  clock_now || { echo 'pocketufw: monotonic clock unavailable' >&2; exit 75; }
  [ "$clock_seconds" -gt "$wait_until" ] ||
    { [ "$clock_seconds" -eq "$wait_until" ] && [ "$clock_fraction" -ge "$wait_fraction" ]; }
}

# Serialize the whole lifecycle, including boot files and final removal readback.
# FD 8 is inherited by nested scripts; FD 9 remains the engine snapshot lock.
# Share FD inheritance with pocketufw; boot-service uses a longer bounded retry window.
operation_lock="${POCKETUFW_LOCK:-/dev/.pocketufw.lock}.operation"
command -v flock >/dev/null 2>&1 || { echo 'pocketufw: lifecycle locking unavailable' >&2; exit 75; }
if [ "$(readlink /proc/$$/fd/8 2>/dev/null)" != "$operation_lock" ]; then
  [ ! -L "$operation_lock" ] || { echo 'pocketufw: unsafe lifecycle lock' >&2; exit 1; }
  ( umask 077; : >>"$operation_lock" && chmod 600 "$operation_lock" ) || exit 1
  exec 8>>"$operation_lock"
fi
operation_wait=15
start_deadline "$operation_wait"
while :; do
  if deadline_reached; then
    echo 'pocketufw: lifecycle lock busy; recheck before retrying' >&2
    exit 75
  fi
  operation_error=$(flock -n -x 8 8>&8 2>&1) && break
  if [ -n "$operation_error" ]; then
    echo 'pocketufw: lifecycle locking unavailable; recheck before retrying' >&2
    exit 75
  fi
  sleep 0.1
done
# mksh closes descriptors above 2 for children unless they are passed explicitly.
sh() { command sh "$@" 8>&8; }
;; esac

owned_hook() {
  [ -f "$HOOK" ] && [ ! -L "$HOOK" ] &&
    grep -qxF "$SIGNATURE" "$HOOK"
}

# A copy interrupted before its signature was written is empty, so that counts as ours.
owned_stage() {
  [ -f "$HOOK.stage" ] && [ ! -L "$HOOK.stage" ] &&
    { [ ! -s "$HOOK.stage" ] || grep -qxF "$SIGNATURE" "$HOOK.stage"; }
}

# Never overwrite unrelated scripts or follow preexisting symlinks.
safe_paths() {
  [ ! -L "$STORE" ] || fail 'Refusing symlink at boot data directory'
  [ ! -e "$STORE" ] || [ -d "$STORE" ] || fail 'Boot data path is not a directory'
  if [ -e "$HOOK" ] || [ -L "$HOOK" ]; then
    owned_hook || fail 'Boot hook path belongs to something else'
  fi
  for name in pocketufw vpn-probe udp-config boot.enabled .pocketufw.stage .vpn-probe.stage .udp-config.stage .boot.enabled.stage; do
    [ ! -L "$STORE/$name" ] || fail 'Refusing symlink in boot data'
    [ ! -d "$STORE/$name" ] || fail 'Refusing directory in boot data'
  done
  [ ! -L "$HOOK.stage" ] || fail 'Refusing symlink at hook staging path'
  if [ "$CMD" = enable ] && [ -e "$HOOK.stage" ]; then
    owned_stage || fail 'Boot hook staging path belongs to something else'
  fi
}

supported() {
  command -v magisk >/dev/null 2>&1 &&
    [ -d /data/adb/service.d ] &&
    [ -r "$SELF_DIR/pocketufw" ] &&
    [ -r "$SELF_DIR/vpn-probe" ] &&
    [ -r "$SELF_DIR/udp-config" ] &&
    [ -r "$SELF_DIR/boot-service" ]
}

# An app upgrade replaces the sources but not the root-owned boot copies, so an
# armed hook can keep running an old engine. A source we cannot read proves nothing.
copies_stale() {
  command -v cmp >/dev/null 2>&1 || return 1
  for name in pocketufw vpn-probe udp-config; do
    [ -r "$SELF_DIR/$name" ] || continue
    cmp -s "$SELF_DIR/$name" "$STORE/$name" || return 0
  done
  [ -r "$SELF_DIR/boot-service" ] && ! cmp -s "$SELF_DIR/boot-service" "$HOOK"
}

case "$CMD" in
  status)
    if [ -L "$STORE" ] || [ -L "$HOOK" ]; then
      say 'boot=CONFLICT'
    elif [ -e "$HOOK" ] && ! owned_hook; then
      say 'boot=CONFLICT'
    elif owned_hook; then
      if [ -f "$MARKER" ] &&
         [ -f "$STORE/pocketufw" ] &&
         [ -f "$STORE/vpn-probe" ] &&
         [ -f "$STORE/udp-config" ]; then
        if copies_stale; then say 'boot=STALE'; else say 'boot=ENABLED'; fi
      else
        say 'boot=DEGRADED'
      fi
    elif [ -e "$MARKER" ]; then
      say 'boot=DEGRADED'
    elif supported; then
      say 'boot=DISABLED'
    else
      say 'boot=UNSUPPORTED'
    fi
    ;;
  enable)
    supported || fail 'Magisk late-start boot scripts not available'
    safe_paths
    verify=$(sh "$SELF_DIR/pocketufw" verify 2>/dev/null) ||
      fail 'Enable the firewall and verify both families first'
    [ "$verify" = 'ACTIVE' ] ||
      fail 'Enable the firewall before configuring boot restoration'

    mkdir -p "$STORE" || fail 'Cannot create root-owned boot directory'
    chmod 700 "$STORE"
    for name in pocketufw vpn-probe udp-config; do
      cp "$SELF_DIR/$name" "$STORE/.$name.stage" ||
        fail "Cannot stage $name"
      chmod 700 "$STORE/.$name.stage"
    done
    cp "$SELF_DIR/boot-service" "$HOOK.stage" ||
      fail 'Cannot stage Magisk boot hook'
    chmod 700 "$HOOK.stage"
    # Install files before enabling the hook. The marker is written last.
    mv -f "$STORE/.pocketufw.stage" "$STORE/pocketufw"
    mv -f "$STORE/.vpn-probe.stage" "$STORE/vpn-probe"
    mv -f "$STORE/.udp-config.stage" "$STORE/udp-config"
    mv -f "$HOOK.stage" "$HOOK"
    printf 'enabled\n' > "$STORE/.boot.enabled.stage"
    chmod 600 "$STORE/.boot.enabled.stage"
    mv -f "$STORE/.boot.enabled.stage" "$MARKER"
    owned_hook && [ -f "$MARKER" ] ||
      fail 'Boot hook not verified'
    say 'boot=ENABLED'
    ;;
  disable)
    safe_paths
    # Disarm at the service entrypoint first, then remove its own files.
    if owned_hook; then rm -f "$HOOK" || fail 'Unable to remove boot hook'; fi
    # Magisk runs any executable in service.d, and this one is executable.
    if owned_stage; then rm -f "$HOOK.stage" || fail 'Unable to remove boot hook'; fi
    if [ -d "$STORE" ]; then
      rm -f "$MARKER" "$STORE/pocketufw" "$STORE/vpn-probe" "$STORE/udp-config" ||
        fail 'Unable to remove PocketUFW boot data'
      rm -f "$STORE/.pocketufw.stage" "$STORE/.vpn-probe.stage" "$STORE/.udp-config.stage" "$STORE/.boot.enabled.stage"
      rmdir "$STORE" 2>/dev/null || :
    fi
    say 'boot=DISABLED'
    ;;
  purge)
    # Everything PocketUFW ever installed, by exact name, including when another
    # owner holds the hook path. What isn't provably ours stays, and residue says so.
    purge_status=0
    if owned_hook; then rm -f "$HOOK" 2>/dev/null || purge_status=1; fi
    if owned_stage; then rm -f "$HOOK.stage" 2>/dev/null || purge_status=1; fi
    if [ -d "$STORE" ] && [ ! -L "$STORE" ]; then
      # rm -f unlinks a symlink rather than following it, and refuses a directory.
      for name in boot.enabled pocketufw vpn-probe udp-config .pocketufw.stage .vpn-probe.stage .udp-config.stage .boot.enabled.stage; do
        rm -f "$STORE/$name" 2>/dev/null || purge_status=1
      done
      rmdir "$STORE" 2>/dev/null || :
    fi
    exit "$purge_status"
    ;;
  residue)
    # Read-only. Reports what is on disk now, however it got there.
    boot_left=''
    boot_kept=''
    if [ -L "$HOOK" ]; then boot_kept='boot_hook'
    elif owned_hook; then boot_left='boot_hook'
    elif [ -e "$HOOK" ]; then boot_kept='boot_hook'; fi
    if [ -L "$HOOK.stage" ]; then boot_kept="${boot_kept:+$boot_kept,}boot_hook_stage"
    elif owned_stage; then boot_left="${boot_left:+$boot_left,}boot_hook_stage"
    elif [ -e "$HOOK.stage" ]; then boot_kept="${boot_kept:+$boot_kept,}boot_hook_stage"; fi
    if [ -L "$STORE" ]; then boot_kept="${boot_kept:+$boot_kept,}boot_data"
    elif [ -e "$STORE" ]; then boot_left="${boot_left:+$boot_left,}boot_data"; fi
    say "boot_left=$boot_left"
    say "boot_kept=$boot_kept"
    ;;
esac
