#!/system/bin/sh
# PocketUFW Insights: developer-only, ON-DEMAND bounded NFLOG capture.
#
# This tool is NOT integrated into the UI or boot lifecycle.
# capture adds non-verdict NFLOG probes immediately before the two PocketUFW
# DROP rules in both IP families and removes only its exact tagged rules.
# The current PocketUFW verifier will report DEGRADED while probes exist.
#
# Usage: insights-capture preflight | capture
# capture writes PCAP bytes ONLY to stdout. Diagnostics go to stderr.
# Not unattended-safe: SIGKILL/power loss cannot run shell cleanup traps.
set -eu

usage() { echo 'Usage: insights-capture preflight | capture' >&2; exit 2; }
[ "$#" -eq 1 ] || usage
case "$1" in preflight|capture) ACTION="$1" ;; *) usage ;; esac
[ "$(id -u)" = 0 ] || { echo 'insights: root required' >&2; exit 3; }
case "$0" in */*) BASE=${0%/*} ;; *) echo 'insights: invoke via path' >&2; exit 2 ;; esac
ENGINE="$BASE/pocketufw"
[ -r "$ENGINE" ] || { echo 'insights: PocketUFW engine missing' >&2; exit 4; }
IPT4="${POCKETUFW_IPTABLES4:-iptables}"
IPT6="${POCKETUFW_IPTABLES6:-ip6tables}"
DUMP="${PUFW_INSIGHTS_TCPDUMP:-tcpdump}"
TIMEOUT="${PUFW_INSIGHTS_TIMEOUT:-timeout}"
CHAIN='POCKETUFW_IN'
GROUP=17
LOCK="$BASE/.insights-capture.lock"

for bin in "$IPT4" "$IPT6" "$DUMP" "$TIMEOUT"; do
  command -v "$bin" >/dev/null 2>&1 ||
    { echo "insights: missing executable: $bin" >&2; exit 4; }
done

# Independent full-policy verification protects against inserting into a
# degraded, unrecognized, or already instrumented firewall.
[ "$(sh "$ENGINE" verify 2>/dev/null)" = 'ACTIVE' ] ||
  { echo 'insights: firewall is not independently verified ACTIVE' >&2; exit 5; }
[ ! -e "$LOCK" ] ||
  { echo 'insights: interrupted or concurrent capture lock; inspect manually' >&2; exit 6; }

if [ "$ACTION" = preflight ]; then
  echo 'insights=READY'
  echo 'mode=ON_DEMAND'
  echo 'duration_limit_seconds=10'
  echo 'packet_limit=1024'
  echo 'live_firewall_modified=no'
  exit 0
fi

# Session-unique names mean cleanup never removes another logger's rules.
INVALID_PREFIX="PUFW_INSIGHTS:$$:I"
FINAL_PREFIX="PUFW_INSIGHTS:$$:F"
acquired=0

probe() {
  binary="$1"; reason="$2"; operation="$3"; size="$4"
  case "$reason" in
    I) set -- -m conntrack --ctstate INVALID -j NFLOG \
         --nflog-group "$GROUP" --nflog-size "$size" \
         --nflog-prefix "$INVALID_PREFIX" ;;
    F) set -- -j NFLOG --nflog-group "$GROUP" --nflog-size "$size" \
         --nflog-prefix "$FINAL_PREFIX" ;;
    *) return 1 ;;
  esac
  case "$operation" in
    check) "$binary" -w -C "$CHAIN" "$@" ;;
    remove) "$binary" -w -D "$CHAIN" "$@" ;;
    *) return 2 ;;
  esac
}

# If insertion succeeds but a signal arrives before the next statement,
# the matching per-session rule can still be found and removed.
# Retain lock and fail noisily if removal fails.
clean_up() {
  rc=$?
  trap - EXIT HUP INT TERM
  if [ "$acquired" -eq 1 ]; then
    failed=0
    for entry in "6:F:44" "4:F:24" "6:I:44" "4:I:24"; do
      fam=${entry%%:*}; rest=${entry#*:}
      why=${rest%%:*}; size=${rest#*:}
      case "$fam" in 4) bin="$IPT4" ;; 6) bin="$IPT6" ;; esac
      if probe "$bin" "$why" check "$size" >/dev/null 2>&1; then
        if ! probe "$bin" "$why" remove "$size" >/dev/null 2>&1; then
          echo "insights: could not remove owned IPv$fam $why probe" >&2
          failed=1
        fi
      fi
    done
    if [ "$failed" -eq 0 ]; then
      if ! rmdir "$LOCK" 2>/dev/null; then
        echo 'insights: could not release capture lock' >&2
        failed=1
      fi
    fi
    if [ "$failed" -ne 0 ]; then
      echo 'insights: MANUAL INSPECTION REQUIRED; capture lock retained' >&2
      rc=7
    fi
  fi
  exit "$rc"
}

if ! mkdir "$LOCK" 2>/dev/null; then
  echo 'insights: cannot acquire private capture lock' >&2
  exit 6
fi
acquired=1
trap 'clean_up' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# Max copied IP-header bytes: IPv4=24, IPv6=44. Enough for a normal
# destination port while minimizing the chance of collecting app payload.
# After inserting I at position 3, original final DROP shifts from 8 to 9.
# Inserting F at 9 leaves the original final DROP at position 10.
"$IPT4" -w -I "$CHAIN" 3 -m conntrack --ctstate INVALID -j NFLOG \
  --nflog-group "$GROUP" --nflog-size 24 --nflog-prefix "$INVALID_PREFIX"
"$IPT6" -w -I "$CHAIN" 3 -m conntrack --ctstate INVALID -j NFLOG \
  --nflog-group "$GROUP" --nflog-size 44 --nflog-prefix "$INVALID_PREFIX"
"$IPT4" -w -I "$CHAIN" 9 -j NFLOG \
  --nflog-group "$GROUP" --nflog-size 24 --nflog-prefix "$FINAL_PREFIX"
"$IPT6" -w -I "$CHAIN" 9 -j NFLOG \
  --nflog-group "$GROUP" --nflog-size 44 --nflog-prefix "$FINAL_PREFIX"

for entry in "4:I:24" "6:I:44" "4:F:24" "6:F:44"; do
  fam=${entry%%:*}; rest=${entry#*:}
  why=${rest%%:*}; size=${rest#*:}
  case "$fam" in 4) bin="$IPT4" ;; 6) bin="$IPT6" ;; esac
  probe "$bin" "$why" check "$size" >/dev/null 2>&1 ||
    { echo 'insights: probe verification failed' >&2; exit 8; }
done

# No persistent daemon and no PCAP file created by this script.
# -c caps packet count; timeout sends INT to flush a valid PCAP.
rc=0
"$TIMEOUT" -s INT -k 2 10 "$DUMP" -i "nflog:$GROUP" \
  -nn -s 128 -U -w - -c 1024 || rc=$?
case "$rc" in
  0|124) : ;; # packet cap or expected timed stop
  *) echo "insights: capture failed (exit $rc)" >&2; exit 9 ;;
esac
