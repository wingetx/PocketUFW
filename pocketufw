#!/system/bin/sh
# PocketUFW v0.1.0 - EXPERIMENTAL. Rooted Android, iptables legacy.
# Dedicated INPUT chains only. Never changes default policies, OUTPUT or FORWARD.
set -eu

VERSION='0.1.0-dev'
CHAIN='POCKETUFW_IN'
TSCHAIN='POCKETUFW_TS'
# Optional tunnel filter. Off unless asked for, and never restored at boot.
VPNCHAIN='POCKETUFW_VPN'
TRUSTCHAIN='POCKETUFW_TRUST'
# Its own tag, so the physical hooks' exact signature stays what it always was.
VPNTAG='PocketUFW-VPN'
MAX_TUNNEL_HOOKS=8
MAX_TRUST_RULES=6
TRUST=''
# Android interface wildcard syntax supported by iptables (-i wlan+, etc.).
IFACES='wlan+ rmnet+ v4-rmnet+'
TS4=''
TS6=''
AUTO_TS=0
PROBE_FAILED=0
UDP4_SET=0
UDP6_SET=0
CMD=''
DRY_RUN=0
IPT4="${POCKETUFW_IPTABLES4:-iptables}"
IPT6="${POCKETUFW_IPTABLES6:-ip6tables}"

say() { printf '%s\n' "$*"; }
fail() { say "pocketufw: $*" >&2; exit 1; }
usage() {
  cat <<'USAGE'
PocketUFW 0.1.0-dev | EXPERIMENTAL, not for unattended deployment

Usage:
  pocketufw doctor
  pocketufw status
  pocketufw verify
  pocketufw activity     # machine-readable live rule counters
  pocketufw reset-counters   # zero owned counters without changing firewall rules
  pocketufw verbose      # human-readable status and kernel counters
  pocketufw plan [--auto-tailscale | --tailscale-udp4 PORT --tailscale-udp6 PORT]
  pocketufw enable [--auto-tailscale | --tailscale-udp4 PORT --tailscale-udp6 PORT]
  pocketufw refresh
  pocketufw get-ports  # read current verified UDP listeners
  pocketufw set-ports --udp4 PORT|none --udp6 PORT|none  # session-only advanced UDP exceptions
  pocketufw disable
  pocketufw residue    # read-only: does anything in either filter table still mention PocketUFW?
  pocketufw tunnel-plan [--trust PROTO:PEER:PORT]...  # print the optional tunnel rules; change nothing
  pocketufw tunnel-on [--trust PROTO:PEER:PORT]...    # filter tun+ and verified kernel WireGuard
  pocketufw tunnel-refresh  # recheck tunnels and rebind allowances to Tailscale's current tun
  pocketufw tunnel-status   # read-only: filter state, tunnel owners and their proof, allowances
  pocketufw tunnel-off      # remove only the tunnel rules

Default: allow outbound (unchanged), filter inbound only on wlan+, rmnet+, v4-rmnet+.
The tunnel filter is optional and lasts until disable, tunnel-off or the next restart.
--trust takes one Tailscale address, for example tcp:100.64.0.2:22000.
No boot persistence. --auto-tailscale verifies ports on enable; refresh
rechecks Tailscale's verified UDP listeners without restarting the firewall.
Continuous monitoring of subsequent port changes is NOT implemented yet.
Do not use alongside AFWall+'s custom inbound filtering.
USAGE
}
check_port() {
  case "$1" in ''|*[!0-9]*) fail 'UDP ports must be integers from 1 to 65535';; esac
  [ "$1" -ge 1 ] && [ "$1" -le 65535 ] || fail 'UDP ports must be 1..65535'
}
while [ "$#" -gt 0 ]; do
  case "$1" in
    doctor|status|verify|activity|reset-counters|verbose|plan|enable|refresh|get-ports|set-ports|disable|residue|tunnel-plan|tunnel-on|tunnel-refresh|tunnel-status|tunnel-off)
      [ -z "$CMD" ] || fail 'Specify one command'; CMD="$1"; shift ;;
    --udp4|--udp6)
      opt="$1"; shift; [ "$#" -gt 0 ] || fail "$opt requires a port or none"
      case "$1" in
        none) port='' ;;
        0|0*|*[!0-9]*) fail 'Manual UDP exception must be none or a decimal port 1..65535 without leading zeros' ;;
        *) check_port "$1"; port="$1" ;;
      esac
      if [ "$opt" = --udp4 ]; then TS4="$port"; UDP4_SET=1
      else TS6="$port"; UDP6_SET=1; fi
      shift ;;
    --auto-tailscale)
      AUTO_TS=1; shift ;;
    --trust)
      shift; [ "$#" -gt 0 ] || fail '--trust requires PROTO:PEER:PORT'
      case "$1" in ''|*[!0-9a-z:.]*) fail 'Invalid --trust value' ;; esac
      TRUST="${TRUST:+$TRUST }$1"; shift ;;
    --tailscale-udp4|--tailscale-udp6)
      opt="$1"; shift; [ "$#" -gt 0 ] || fail "$opt requires a port"
      check_port "$1"
      if [ "$opt" = '--tailscale-udp4' ]; then TS4="$1"; else TS6="$1"; fi
      shift ;;
    -h|--help|help) usage; exit 0 ;;
    --version) say "$VERSION"; exit 0 ;;
    *) fail "Unknown argument: $1" ;;
  esac
done
[ -n "$CMD" ] || { usage; exit 1; }
case "$CMD" in
  tunnel-on|tunnel-plan) : ;;
  *) [ -z "$TRUST" ] || fail '--trust applies only to tunnel-on and tunnel-plan' ;;
esac
if [ "$CMD" = set-ports ]; then
  [ "$UDP4_SET" -eq 1 ] && [ "$UDP6_SET" -eq 1 ] ||
    fail 'set-ports requires both --udp4 and --udp6 (use none to close one)'
  [ "$AUTO_TS" -eq 0 ] || fail 'Manual ports cannot be combined with --auto-tailscale'
else
  [ "$UDP4_SET" -eq 0 ] && [ "$UDP6_SET" -eq 0 ] ||
    fail '--udp4/--udp6 apply only to set-ports'
fi
if [ "$CMD" != 'enable' ] && [ "$CMD" != 'plan' ] && [ "$CMD" != 'set-ports' ] &&
   { [ -n "$TS4" ] || [ -n "$TS6" ] || [ "$AUTO_TS" -eq 1 ]; }; then
  fail 'Tailscale port options only apply to enable and plan'
fi
if [ "$AUTO_TS" -eq 1 ] && { [ -n "$TS4" ] || [ -n "$TS6" ]; }; then
  fail 'Choose automatic detection OR manually specified Tailscale ports'
fi

fw4() { if [ "$DRY_RUN" -eq 1 ]; then printf '%s' "$IPT4 -w"; printf ' %s' "$@"; printf '\n'; else "$IPT4" -w "$@"; fi; }
fw6() { if [ "$DRY_RUN" -eq 1 ]; then printf '%s' "$IPT6 -w"; printf ' %s' "$@"; printf '\n'; else "$IPT6" -w "$@"; fi; }
root_needed() {
  [ "$(id -u)" -eq 0 ] || fail 'Requires root (run with su -c or sudo in Termux)'
}
prereqs() {
  command -v "$IPT4" >/dev/null 2>&1 || fail 'iptables command not found'
  command -v "$IPT6" >/dev/null 2>&1 || fail 'ip6tables command not found'
}
chain_exists4() { "$IPT4" -w -S "$CHAIN" >/dev/null 2>&1; }
chain_exists6() { "$IPT6" -w -S "$CHAIN" >/dev/null 2>&1; }
ts_exists4() { "$IPT4" -w -S "$TSCHAIN" >/dev/null 2>&1; }
ts_exists6() { "$IPT6" -w -S "$TSCHAIN" >/dev/null 2>&1; }
afwall_active() { "$IPT4" -w -S OUTPUT 2>/dev/null | grep -q -- '-A OUTPUT -j afwall'; }

# The firewall must never depend on Tailscale. For enable, a discovery problem
# withholds only the UDP exceptions; plan and refresh must not guess, so they fail.
probe_problem() {
  [ "$CMD" = enable ] || fail "$1"
  say "pocketufw: $1" >&2
  PROBE_FAILED=1
  TS4=''
  TS6=''
}
port_is_valid() {
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  [ "${#1}" -le 5 ] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}
resolve_tailscale_ports() {
  [ "$AUTO_TS" -eq 1 ] || return 0
  root_needed
  # Resolve probe relative to the PocketUFW CLI, never search arbitrary directories.
  case "$0" in
    */*) script_path="$0" ;;
    *) script_path=$(command -v "$0") || { probe_problem 'Cannot locate PocketUFW CLI'; return 0; } ;;
  esac
  case "$script_path" in */*) probe_dir=${script_path%/*} ;; *) probe_dir=. ;; esac
  [ -r "$probe_dir/vpn-probe" ] || { probe_problem 'vpn-probe not installed alongside PocketUFW'; return 0; }
  # The probe does not need the engine lock, so a stuck child cannot keep it.
  discovered=$(sh "$probe_dir/vpn-probe" 9>&-) || {
    probe_problem 'Tailscale port discovery failed; no VPN port exceptions changed'
    return 0
  }
  TS4=$(printf '%s\n' "$discovered" | sed -n 's/^tailscale_udp4=//p')
  TS6=$(printf '%s\n' "$discovered" | sed -n 's/^tailscale_udp6=//p')
  { [ -z "$TS4" ] || port_is_valid "$TS4"; } && { [ -z "$TS6" ] || port_is_valid "$TS6"; } ||
    probe_problem 'Tailscale port discovery returned an invalid port'
}

# The only chain we own is POCKETUFW_IN in the IPv4 and IPv6 filter tables.
# Existing Android rules run first; only physical interfaces are hooked.
build_rules() {
  fw4 -N "$CHAIN"
  fw6 -N "$CHAIN"
  fw4 -N "$TSCHAIN"
  fw6 -N "$TSCHAIN"
  fw4 -A "$CHAIN" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  fw6 -A "$CHAIN" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  # IPv6 control traffic is necessary for router/neighbor discovery and PMTU.
  fw4 -A "$CHAIN" -p icmp -j ACCEPT
  fw6 -A "$CHAIN" -p ipv6-icmp -j ACCEPT
  fw4 -A "$CHAIN" -m conntrack --ctstate INVALID -j DROP
  fw6 -A "$CHAIN" -m conntrack --ctstate INVALID -j DROP
  fw4 -A "$CHAIN" -p udp --sport 67 --dport 68 -j ACCEPT
  fw6 -A "$CHAIN" -p udp --sport 547 --dport 546 -j ACCEPT
  fw4 -A "$CHAIN" -p udp -d 224.0.0.251 --dport 5353 -j ACCEPT
  fw6 -A "$CHAIN" -p udp -d ff02::fb --dport 5353 -j ACCEPT
  # ESP may be needed by carrier IMS. Still filtered to physical INPUT hooks.
  fw4 -A "$CHAIN" -p esp -j ACCEPT
  fw6 -A "$CHAIN" -p esp -j ACCEPT
  # Dedicated child chains let refresh replace verified ports without
  # flushing the main inbound policy or existing connection state.
  if [ -n "$TS4" ]; then fw4 -A "$TSCHAIN" -p udp --dport "$TS4" -j ACCEPT; fi
  if [ -n "$TS6" ]; then fw6 -A "$TSCHAIN" -p udp --dport "$TS6" -j ACCEPT; fi
  fw4 -A "$CHAIN" -j "$TSCHAIN"
  fw6 -A "$CHAIN" -j "$TSCHAIN"
  fw4 -A "$CHAIN" -j DROP
  fw6 -A "$CHAIN" -j DROP
}
hooks_attach() {
  for iface in $IFACES; do
    fw4 -A INPUT -i "$iface" -m comment --comment PocketUFW -j "$CHAIN"
    fw6 -A INPUT -i "$iface" -m comment --comment PocketUFW -j "$CHAIN"
  done
}
remove_one_family() {
  fam="$1"
  if [ "$fam" = '4' ]; then
    bin="$IPT4"
  else
    bin="$IPT6"
  fi
  remove_tunnel_family "$bin"
  for iface in $IFACES; do
    # Delete only hooks that match our full signature, never other owners' rules.
    while "$bin" -w -C INPUT -i "$iface" -m comment --comment PocketUFW -j "$CHAIN" >/dev/null 2>&1; do
      "$bin" -w -D INPUT -i "$iface" -m comment --comment PocketUFW -j "$CHAIN" || break
    done
  done
  if "$bin" -w -S "$CHAIN" >/dev/null 2>&1; then
    "$bin" -w -F "$CHAIN"
    "$bin" -w -X "$CHAIN"
  fi
  # Only after our parent chain is gone can its VPN child be deleted.
  if "$bin" -w -S "$TSCHAIN" >/dev/null 2>&1; then
    "$bin" -w -F "$TSCHAIN"
    "$bin" -w -X "$TSCHAIN"
  fi
}
cleanup() {
  # Best-effort cleanup only for chains/hook signatures owned by PocketUFW.
  remove_one_family 4 || :
  remove_one_family 6 || :
}

verify_family() {
  bin="$1"
  family="$2"
  "$bin" -w -S "$TSCHAIN" >/dev/null 2>&1 || return 1
  rules=$("$bin" -w -S "$CHAIN") || return 1
  # Check exact rule count so extra, unintended ACCEPT rules are not silently trusted.
  rule_count=$(printf '%s\n' "$rules" | grep -c -- "^-A $CHAIN ") || return 1
  [ "$rule_count" -eq 8 ] || return 1
  # Membership alone cannot detect a reordered rule (and can falsely report
  # ACTIVE when an earlier ACCEPT changes what reaches an intended DROP).
  # Confirm the complete jump-target sequence, then check each rule's exact
  # match with iptables -C below. -S formatting may normalize match options.
  targets=$(printf '%s\n' "$rules" | awk -v chain="$CHAIN" '
    $1 == "-A" && $2 == chain {
      if ($(NF-1) != "-j") exit 2
      printf "%s ", $NF
    }
  ') || return 1
  [ "$targets" = "ACCEPT ACCEPT DROP ACCEPT ACCEPT ACCEPT $TSCHAIN DROP " ] || return 1
  # A well-formed parent is not protective if its VPN child has a broad
  # ACCEPT. Accept only an empty child or one explicit UDP listener exception.
  (current_tailscale_port "$bin" >/dev/null 2>&1) || return 1
  for iface in $IFACES; do
    "$bin" -w -C INPUT -i "$iface" -m comment --comment PocketUFW -j "$CHAIN" >/dev/null 2>&1 || return 1
  done
  # Kernel normalizes the order of ESTABLISHED,RELATED in -S output, so use
  # netfilter's own semantic -C test instead of comparing rendered strings.
  "$bin" -w -C "$CHAIN" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT >/dev/null 2>&1 || return 1
  "$bin" -w -C "$CHAIN" -m conntrack --ctstate INVALID -j DROP >/dev/null 2>&1 || return 1
  "$bin" -w -C "$CHAIN" -p esp -j ACCEPT >/dev/null 2>&1 || return 1
  "$bin" -w -C "$CHAIN" -j "$TSCHAIN" >/dev/null 2>&1 || return 1
  if [ "$family" -eq 4 ]; then
    "$bin" -w -C "$CHAIN" -p icmp -j ACCEPT >/dev/null 2>&1 || return 1
    "$bin" -w -C "$CHAIN" -p udp --sport 67 --dport 68 -j ACCEPT >/dev/null 2>&1 || return 1
    "$bin" -w -C "$CHAIN" -p udp -d 224.0.0.251 --dport 5353 -j ACCEPT >/dev/null 2>&1 || return 1
  else
    "$bin" -w -C "$CHAIN" -p ipv6-icmp -j ACCEPT >/dev/null 2>&1 || return 1
    "$bin" -w -C "$CHAIN" -p udp --sport 547 --dport 546 -j ACCEPT >/dev/null 2>&1 || return 1
    "$bin" -w -C "$CHAIN" -p udp -d ff02::fb --dport 5353 -j ACCEPT >/dev/null 2>&1 || return 1
  fi
  [ "$(printf '%s\n' "$rules" | tail -n 1)" = "-A $CHAIN -j DROP" ] || return 1
}

verify_all() {
  verify_family "$IPT4" 4 && verify_family "$IPT6" 6 && verify_tunnel
}

# --- Optional tunnel filter ---------------------------------------------------
# Deny is broad and needs no proof: tun+ covers every Android VPN, whichever app
# holds it and whatever number the kernel gave it. An allowance is the opposite:
# it binds one peer and port to a tunnel proven to be Tailscale's, addressed to
# Tailscale's own address. See docs/tunnel-filtering.md.

fwf() { family="$1"; shift; if [ "$family" = 4 ]; then fw4 "$@"; else fw6 "$@"; fi; }
tunnel_present() {
  "$IPT4" -w -S "$VPNCHAIN" >/dev/null 2>&1 || "$IPT6" -w -S "$VPNCHAIN" >/dev/null 2>&1 ||
    "$IPT4" -w -S "$TRUSTCHAIN" >/dev/null 2>&1 || "$IPT6" -w -S "$TRUSTCHAIN" >/dev/null 2>&1
}

# Interface names reach iptables as arguments, so they must not read as options or
# wildcards. Physical patterns already have their own policy and are never tunnels.
iface_is_safe() {
  case "$1" in ''|-*|*[!A-Za-z0-9_.-]*) return 1 ;; lo|wlan*|rmnet*|v4-rmnet*) return 1 ;; esac
  [ "${#1}" -le 15 ]
}

# One address a tailnet can assign, never a range, so a typo can't widen an allowance
# to the internet. Prints the family.
tailnet_family() {
  case "$1" in
    *[!0-9.]*)
      case "$1" in fd7a:115c:a1e0:*) : ;; *) return 1 ;; esac
      case "$1" in *[!0-9a-f:]*) return 1 ;; esac
      [ "${#1}" -le 39 ] || return 1
      echo 6 ;;
    *)
      old_ifs="$IFS"; IFS=.; set -- $1; IFS="$old_ifs"
      [ "$#" -eq 4 ] && [ "$1" = 100 ] || return 1
      for octet in "$@"; do
        case "$octet" in ''|0?*|*[!0-9]*) return 1 ;; esac
        [ "${#octet}" -le 3 ] && [ "$octet" -le 255 ] || return 1
      done
      [ "$2" -ge 64 ] && [ "$2" -le 127 ] || return 1
      echo 4 ;;
  esac
}
parse_trust() {
  trust_proto=${1%%:*}
  trust_rest=${1#*:}
  trust_port=${trust_rest##*:}
  trust_peer=${trust_rest%:*}
  case "$trust_proto" in tcp|udp) : ;; *) return 1 ;; esac
  [ "$trust_rest" != "$trust_port" ] || return 1
  case "$trust_port" in 0*) return 1 ;; esac
  port_is_valid "$trust_port" || return 1
  trust_family=$(tailnet_family "$trust_peer")
}
family_bits() { if [ "$1" = 4 ]; then echo 32; else echo 128; fi; }

# The probe's report is all or nothing: one that didn't finish decides nothing.
read_inventory() {
  case "$0" in */*) inventory_script="$0" ;; *) inventory_script=$(command -v "$0") || return 1 ;; esac
  case "$inventory_script" in */*) inventory_dir=${inventory_script%/*} ;; *) inventory_dir=. ;; esac
  [ -r "$inventory_dir/vpn-probe" ] || return 1
  INVENTORY=$(sh "$inventory_dir/vpn-probe" tunnels 9>&-) || return 1
  printf '%s\n' "$INVENTORY" | grep -qx 'inventory=COMPLETE'
}
wireguard_names() {
  for wg_name in $(printf '%s\n' "$INVENTORY" | sed -n 's/^tunnel=\([^ ]*\) kind=wireguard .*/\1/p'); do
    if iface_is_safe "$wg_name"; then
      # tun+ already covers these, and a second hook would only be counted twice.
      case "$wg_name" in tun*) continue ;; esac
      printf '%s\n' "$wg_name"
    fi
  done
}
# Exactly one tunnel, which the kernel and Android both say is Tailscale's.
tailscale_tun() {
  ts_tuns=$(printf '%s\n' "$INVENTORY" |
    sed -n 's/^tunnel=\([^ ]*\) kind=tun owner=com\.tailscale\.ipn proof=verified$/\1/p')
  case "$ts_tuns" in ''|*[!A-Za-z0-9_.-]*) return 1 ;; esac
  iface_is_safe "$ts_tuns" && printf '%s\n' "$ts_tuns"
}
own_tailnet_addr() {
  for own_addr in $(ip -o "-$1" addr show dev "$2" scope global 2>/dev/null |
                    awk '{ sub(/\/.*/, "", $4); print $4 }'); do
    if [ "$(tailnet_family "$own_addr" 2>/dev/null)" = "$1" ]; then
      printf '%s\n' "$own_addr"
      return 0
    fi
  done
  return 1
}

# Fills TUNNEL_NAMES and TRUST_PLAN, or stops before anything has been changed.
prepare_tunnel() {
  read_inventory || fail 'Could not read the current tunnels; nothing changed'
  TUNNEL_NAMES=$(wireguard_names)
  hook_total=1
  for name in $TUNNEL_NAMES; do hook_total=$((hook_total + 1)); done
  [ "$hook_total" -le "$MAX_TUNNEL_HOOKS" ] || fail 'Too many tunnels to hook; nothing changed'
  TRUST_PLAN=''
  [ -n "$TRUST" ] || return 0
  ts_tun=$(tailscale_tun) ||
    fail 'An allowance needs a Tailscale tunnel proven by both the kernel and Android; nothing changed'
  trust_total4=0; trust_total6=0
  for spec in $TRUST; do
    parse_trust "$spec" || fail "Invalid --trust $spec: use tcp|udp:TAILSCALE_ADDRESS:PORT; nothing changed"
    own=$(own_tailnet_addr "$trust_family" "$ts_tun") ||
      fail "Tailscale's tunnel has no IPv$trust_family address for --trust $spec; nothing changed"
    if [ "$trust_family" = 4 ]; then trust_total4=$((trust_total4 + 1)); else trust_total6=$((trust_total6 + 1)); fi
    TRUST_PLAN="$TRUST_PLAN$trust_family $trust_proto $trust_peer $own $ts_tun $trust_port
"
  done
  [ "$trust_total4" -le "$MAX_TRUST_RULES" ] && [ "$trust_total6" -le "$MAX_TRUST_RULES" ] ||
    fail 'Too many allowances; nothing changed'
}
# trust_rule -A|-D FAMILY PROTO PEER OWN IFACE PORT
trust_rule() {
  fwf "$2" "$1" "$TRUSTCHAIN" -s "$4/$(family_bits "$2")" -d "$5/$(family_bits "$2")" \
    -i "$6" -p "$3" --dport "$7" -j ACCEPT
}
install_tunnel_rules() {
  for family_now in 4 6; do
    fwf "$family_now" -N "$VPNCHAIN"
    fwf "$family_now" -N "$TRUSTCHAIN"
    fwf "$family_now" -A "$VPNCHAIN" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    fwf "$family_now" -A "$VPNCHAIN" -m conntrack --ctstate INVALID -j DROP
    fwf "$family_now" -A "$VPNCHAIN" -j "$TRUSTCHAIN"
    fwf "$family_now" -A "$VPNCHAIN" -j DROP
  done
  # Allowances exist before any hook does, so trusted traffic never sees a gap.
  while read -r p_family p_proto p_peer p_own p_iface p_port; do
    [ -n "$p_family" ] || continue
    trust_rule -A "$p_family" "$p_proto" "$p_peer" "$p_own" "$p_iface" "$p_port"
  done <<EOF
$TRUST_PLAN
EOF
  for family_now in 4 6; do
    for name in tun+ $TUNNEL_NAMES; do
      fwf "$family_now" -A INPUT -i "$name" -m comment --comment "$VPNTAG" -j "$VPNCHAIN"
    done
  done
}

# Names hooked in INPUT. Any line naming our chain or tag that isn't exactly our
# hook is a failure, so an edited hook can't pass as one of ours.
tunnel_hook_names() {
  hook_listing=$("$1" -w -S INPUT) || return 1
  printf '%s\n' "$hook_listing" | awk -v chain="$VPNCHAIN" -v tag="$VPNTAG" '
    index($0, chain) || index($0, tag) {
      if (NF != 10 || $1 != "-A" || $2 != "INPUT" || $3 != "-i" || $5 != "-m" || $6 != "comment" ||
          $7 != "--comment" || $8 != tag || $9 != "-j" || $10 != chain ||
          $4 !~ /^[A-Za-z0-9_.-]+[+]?$/) { bad = 1; exit }
      print $4
    }
    END { exit bad }
  '
}
# Prints "proto peer own iface port" per allowance, and fails on anything else, so
# only exact peer-to-own-address rules on one interface can ever pass.
read_trust() {
  trust_listing=$("$1" -w -S "$TRUSTCHAIN") || return 1
  trust_seen=0
  while IFS= read -r line; do
    case "$line" in
      "-N $TRUSTCHAIN") continue ;;
      "-A $TRUSTCHAIN "*)
        fields=$(printf '%s\n' "$line" | sed -n -E "s#^-A $TRUSTCHAIN -s ([0-9a-f:.]+)/([0-9]+) -d ([0-9a-f:.]+)/([0-9]+) -i ([A-Za-z0-9_.-]+) -p (tcp|udp) (-m (tcp|udp) )?--dport ([0-9]+) -j ACCEPT\$#\\6 \\1 \\3 \\5 \\9 \\2 \\4#p")
        [ -n "$fields" ] || return 2
        set -- "$1" "$2" $fields
        [ "$8" = "$(family_bits "$2")" ] && [ "$9" = "$(family_bits "$2")" ] || return 2
        [ "$(tailnet_family "$4" 2>/dev/null)" = "$2" ] || return 2
        [ "$(tailnet_family "$5" 2>/dev/null)" = "$2" ] || return 2
        iface_is_safe "$6" && port_is_valid "$7" || return 2
        trust_seen=$((trust_seen + 1))
        [ "$trust_seen" -le "$MAX_TRUST_RULES" ] || return 2
        printf '%s %s %s %s %s\n' "$3" "$4" "$5" "$6" "$7"
        ;;
      *) return 2 ;;
    esac
  done <<EOF
$trust_listing
EOF
}
verify_tunnel_family() {
  vbin="$1"; vfam="$2"
  vrules=$("$vbin" -w -S "$VPNCHAIN") || return 1
  vcount=$(printf '%s\n' "$vrules" | grep -c -- "^-A $VPNCHAIN ") || return 1
  [ "$vcount" -eq 4 ] || return 1
  vtargets=$(printf '%s\n' "$vrules" | awk -v chain="$VPNCHAIN" '
    $1 == "-A" && $2 == chain {
      if ($(NF-1) != "-j") exit 2
      printf "%s ", $NF
    }
  ') || return 1
  [ "$vtargets" = "ACCEPT DROP $TRUSTCHAIN DROP " ] || return 1
  "$vbin" -w -C "$VPNCHAIN" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT >/dev/null 2>&1 || return 1
  "$vbin" -w -C "$VPNCHAIN" -m conntrack --ctstate INVALID -j DROP >/dev/null 2>&1 || return 1
  "$vbin" -w -C "$VPNCHAIN" -j "$TRUSTCHAIN" >/dev/null 2>&1 || return 1
  [ "$(printf '%s\n' "$vrules" | tail -n 1)" = "-A $VPNCHAIN -j DROP" ] || return 1
  (read_trust "$vbin" "$vfam" >/dev/null 2>&1) || return 1
  vhooks=$(tunnel_hook_names "$vbin") || return 1
  vtotal=0; vtun=0
  for name in $vhooks; do
    vtotal=$((vtotal + 1))
    if [ "$name" = 'tun+' ]; then vtun=1; fi
  done
  [ "$vtun" -eq 1 ] && [ "$vtotal" -le "$MAX_TUNNEL_HOOKS" ]
}
# Off is a correct state: this filter is optional. On has to be complete and alike
# in both families, or the firewall as a whole is degraded.
verify_tunnel() {
  tunnel_present || return 0
  verify_tunnel_family "$IPT4" 4 && verify_tunnel_family "$IPT6" 6 || return 1
  [ "$(tunnel_hook_names "$IPT4" | sort)" = "$(tunnel_hook_names "$IPT6" | sort)" ]
}
remove_tunnel_family() {
  rbin="$1"
  # Delete only hooks matching our full signature, never other owners' rules.
  for name in $("$rbin" -w -S INPUT 2>/dev/null | sed -n "s/^-A INPUT -i \([A-Za-z0-9_.+-]*\) -m comment --comment $VPNTAG -j $VPNCHAIN\$/\1/p"); do
    while "$rbin" -w -C INPUT -i "$name" -m comment --comment "$VPNTAG" -j "$VPNCHAIN" >/dev/null 2>&1; do
      "$rbin" -w -D INPUT -i "$name" -m comment --comment "$VPNTAG" -j "$VPNCHAIN" || break
    done
  done
  for owned in "$VPNCHAIN" "$TRUSTCHAIN"; do
    if "$rbin" -w -S "$owned" >/dev/null 2>&1; then
      "$rbin" -w -F "$owned" || :
      "$rbin" -w -X "$owned" || :
    fi
  done
}
read_trust_hits() {
  hits_listing=$("$1" -w -L "$TRUSTCHAIN" -n -v -x) || return 1
  printf '%s\n' "$hits_listing" | awk '
    NR == 1 && $1 != "Chain" { exit 2 }
    $1 ~ /^[0-9]+$/ && $3 == "ACCEPT" { total += $1 }
    END { printf "%.0f\n", total }
  '
}
# Separate from the physical counters, which keep meaning exactly what they meant.
collect_tunnel_counters() {
  TUNNEL_FILTER=OFF
  tunnel_present || return 0
  TUNNEL_FILTER=ON
  tcount4=$(read_counters "$IPT4" "$VPNCHAIN") || fail 'Cannot read IPv4 tunnel counters; not claiming a measurement'
  tcount6=$(read_counters "$IPT6" "$VPNCHAIN") || fail 'Cannot read IPv6 tunnel counters; not claiming a measurement'
  ttrusted4=$(read_trust_hits "$IPT4") || fail 'Cannot read IPv4 allowance counters; not claiming a measurement'
  ttrusted6=$(read_trust_hits "$IPT6") || fail 'Cannot read IPv6 allowance counters; not claiming a measurement'
  set -- $tcount4
  tblocked4="$1"; tbytes4="$2"; treplies4="$3"
  set -- $tcount6
  tblocked6="$1"; tbytes6="$2"; treplies6="$3"
  thooks=$(tunnel_hook_names "$IPT4" | tr '\n' ',') || fail 'Cannot read tunnel hooks'
  thooks=${thooks%,}
}

# Read-only kernel packet counters. We count only our own DROP targets, not
# Android/OEM drops, and deliberately don't infer attacks from these packets.
# These counters start over whenever PocketUFW rules are reinstalled or reset.
read_counters() {
  ipt="$1"
  listing=$("$ipt" -w -L "${2:-$CHAIN}" -n -v -x) || return 1
  printf '%s\n' "$listing" | awk '
    NR == 1 && $1 != "Chain" { exit 2 }
    $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 == "DROP" {
      blocked += $1; bytes += $2; drop_rules++
    }
    $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 == "ACCEPT" &&
      /ctstate/ && /ESTABLISHED/ && /RELATED/ {
      replies += $1; established_rules++
    }
    END {
      if (drop_rules != 2 || established_rules != 1) exit 3
      printf "%.0f %.0f %.0f\n", blocked, bytes, replies
    }
  '
}

collect_counters() {
  if ! chain_exists4 && ! chain_exists6 && ! ts_exists4 && ! ts_exists6 && ! tunnel_present; then
    if [ "$CMD" = 'verbose' ]; then say 'Status: inactive'; return 3; fi
    say 'state=INACTIVE'
    return 3
  fi
  if ! verify_family "$IPT4" 4 || ! verify_family "$IPT6" 6; then
    if [ "$CMD" = 'verbose' ]; then say 'Status: degraded (rules or hooks missing)'; else say 'state=DEGRADED'; fi
    return 4
  fi
  count4=$(read_counters "$IPT4") || fail 'Cannot read IPv4 counters; not claiming a measurement'
  count6=$(read_counters "$IPT6") || fail 'Cannot read IPv6 counters; not claiming a measurement'
  set -- $count4
  blocked4="$1"; bytes4="$2"; replies4="$3"
  set -- $count6
  blocked6="$1"; bytes6="$2"; replies6="$3"
  collect_tunnel_counters
  return 0
}

# Examine only our child chain. The allowed grammar is exactly zero or one
# UDP ACCEPT rule: if an unexpected rule appears, refuse to edit it.
current_tailscale_port() {
  ipt="$1"
  rules=$("$ipt" -w -S "$TSCHAIN") || return 1
  selected=''
  while IFS= read -r line; do
    case "$line" in
      "-N $TSCHAIN") continue ;;
      "-A $TSCHAIN "*)
        found=$(printf '%s\n' "$line" | sed -n -E "s/^-A $TSCHAIN -p udp (-m udp )?--dport ([0-9]+) -j ACCEPT$/\\2/p")
        [ -n "$found" ] || return 2
        check_port "$found"
        [ -z "$selected" ] || return 2
        selected="$found"
        ;;
      *) return 2 ;;
    esac
  done <<EOF
$rules
EOF
  printf '%s\n' "$selected"
}

# Transactional per-family update. First add BOTH new exceptions, then remove
# both obsolete exceptions. If any operation fails, restore the old exceptions
# and delete only the rules that this refresh added.
apply_verified_refresh() {
  added4=0; added6=0; removed4=0; removed6=0; failed=0
  if [ "$TS4" != "$old4" ] && [ -n "$TS4" ]; then
    if "$IPT4" -w -A "$TSCHAIN" -p udp --dport "$TS4" -j ACCEPT; then
      added4=1
    else
      failed=1
    fi
  fi
  if [ "$failed" -eq 0 ] && [ "$TS6" != "$old6" ] && [ -n "$TS6" ]; then
    if "$IPT6" -w -A "$TSCHAIN" -p udp --dport "$TS6" -j ACCEPT; then
      added6=1
    else
      failed=1
    fi
  fi
  if [ "$failed" -eq 0 ] && [ "$old4" != "$TS4" ] && [ -n "$old4" ]; then
    if "$IPT4" -w -D "$TSCHAIN" -p udp --dport "$old4" -j ACCEPT; then
      removed4=1
    else
      failed=1
    fi
  fi
  if [ "$failed" -eq 0 ] && [ "$old6" != "$TS6" ] && [ -n "$old6" ]; then
    if "$IPT6" -w -D "$TSCHAIN" -p udp --dport "$old6" -j ACCEPT; then
      removed6=1
    else
      failed=1
    fi
  fi
  [ "$failed" -eq 0 ] && return 0

  say 'pocketufw: refresh failed; restoring previous UDP exceptions' >&2
  restored=1
  # Restore old ports FIRST to avoid an unnecessary connectivity gap.
  if [ "$removed4" -eq 1 ]; then
    "$IPT4" -w -A "$TSCHAIN" -p udp --dport "$old4" -j ACCEPT || restored=0
  fi
  if [ "$removed6" -eq 1 ]; then
    "$IPT6" -w -A "$TSCHAIN" -p udp --dport "$old6" -j ACCEPT || restored=0
  fi
  if [ "$added4" -eq 1 ]; then
    "$IPT4" -w -D "$TSCHAIN" -p udp --dport "$TS4" -j ACCEPT || restored=0
  fi
  if [ "$added6" -eq 1 ]; then
    "$IPT6" -w -D "$TSCHAIN" -p udp --dport "$TS6" -j ACCEPT || restored=0
  fi
  if [ "$restored" -eq 0 ]; then
    say 'pocketufw: WARNING: rollback command failed; manual rule inspection required' >&2
    return 1
  fi
  restored4=$(current_tailscale_port "$IPT4") || {
    say 'pocketufw: WARNING: IPv4 VPN exception state is ambiguous' >&2
    return 1
  }
  restored6=$(current_tailscale_port "$IPT6") || {
    say 'pocketufw: WARNING: IPv6 VPN exception state is ambiguous' >&2
    return 1
  }
  if [ "$restored4" != "$old4" ] || [ "$restored6" != "$old6" ]; then
    say 'pocketufw: WARNING: rollback verification failed' >&2
  else
    say 'pocketufw: previous verified ports restored' >&2
  fi
  return 1
}

# Cross-process lock: one engine's half-finished install must not be seen as
# DEGRADED by a reader, or be torn down by another engine's failure cleanup.
# Toybox flock takes only a descriptor, so poll -n: 150 x 0.1 s, about 15 s.
# No flock or no usable lock file means proceeding unlocked. Nothing the engine
# runs re-invokes the engine, so holding this cannot deadlock against itself.
lock_engine() {
  command -v flock >/dev/null 2>&1 || return 0
  lock_file="${POCKETUFW_LOCK:-/dev/.pocketufw.lock}"
  # A failed redirect on exec would end this shell, so try it in a subshell. Whatever
  # created this file, and with whatever umask, only root may hold the firewall's lock.
  ( umask 077; : >>"$lock_file" && { chmod 600 "$lock_file" || :; } ) 2>/dev/null || return 0
  exec 9>>"$lock_file"
  lock_polls=0
  while :; do
    # 9>&9 hands the descriptor over explicitly: mksh, Android's sh, keeps exec'd
    # descriptors above 2 from child commands otherwise.
    lock_error=$(flock -n "$1" 9 9>&9 2>&1) && return 0
    # Contention is silent. A diagnostic means flock cannot work here at all.
    [ -z "$lock_error" ] || { exec 9>&-; return 0; }
    [ "$lock_polls" -lt 150 ] || break
    lock_polls=$((lock_polls + 1))
    sleep 0.1 2>/dev/null || :
  done
  exec 9>&-
  [ "$1" = -s ] || fail 'Another PocketUFW operation is still running; no changes made. Try again.'
  say 'pocketufw: another operation is still running; reading without the lock' >&2
}
case "$CMD" in
  enable|disable|refresh|set-ports|reset-counters|tunnel-on|tunnel-refresh|tunnel-off) lock_engine -x ;;
  verify|activity|verbose|status|get-ports|residue|tunnel-status) lock_engine -s ;;
esac

case "$CMD" in
  doctor)
    root_needed
    prereqs
    say "PocketUFW $VERSION | read-only preflight"
    say 'INPUT chain hooks:'
    if chain_exists4 || chain_exists6; then say '  PocketUFW chain exists'; else say '  Not installed'; fi
    if afwall_active; then say '  WARNING: AFWall+ is active; do NOT enable alongside its custom INPUT rules'; else say '  AFWall+ output hook not active'; fi
    say '  Requires iptables legacy, conntrack, IPv6, root, and trusted network interfaces.'
    say '  Assumed physical interfaces: wlan+, rmnet+, v4-rmnet+'
    ;;
  plan)
    DRY_RUN=1
    resolve_tailscale_ports
    say '# DRY RUN ONLY - NOTHING EXECUTED'
    build_rules
    hooks_attach
    ;;
  status)
    root_needed
    prereqs
    if chain_exists4 || chain_exists6 || tunnel_present; then
      say 'PocketUFW: enabled or partially installed'
      say '--- IPv4 ---'
      "$IPT4" -w -S "$CHAIN" 2>/dev/null || true
      "$IPT4" -w -S "$TSCHAIN" 2>/dev/null || true
      "$IPT4" -w -S "$VPNCHAIN" 2>/dev/null || true
      "$IPT4" -w -S "$TRUSTCHAIN" 2>/dev/null || true
      say '--- IPv6 ---'
      "$IPT6" -w -S "$CHAIN" 2>/dev/null || true
      "$IPT6" -w -S "$TSCHAIN" 2>/dev/null || true
      "$IPT6" -w -S "$VPNCHAIN" 2>/dev/null || true
      "$IPT6" -w -S "$TRUSTCHAIN" 2>/dev/null || true
    else
      say 'PocketUFW: disabled'
    fi
    ;;
  verify)
    root_needed
    prereqs
    if ! chain_exists4 && ! chain_exists6 && ! ts_exists4 && ! ts_exists6 && ! tunnel_present; then
      say 'INACTIVE'
      exit 3
    fi
    if verify_all; then
      say 'ACTIVE'
    else
      say 'DEGRADED'
      exit 4
    fi
    ;;
  reset-counters)
    root_needed
    prereqs
    # Never reset Android/OEM INPUT or other managers' counters.
    # Verify the complete owned grammar in BOTH address families first.
    verify_all ||
      fail 'Firewall inactive or degraded; no counters reset'
    # Only PocketUFW's parent and Tailscale child chains are zeroed.
    # These operations preserve each rule, hook, policy and VPN exception.
    fw4 -Z "$CHAIN" || fail 'IPv4 parent counter reset failed'
    fw6 -Z "$CHAIN" || fail 'IPv6 parent counter reset failed; IPv4 already reset'
    fw4 -Z "$TSCHAIN" || fail 'IPv4 VPN counter reset failed; parent counters already reset'
    fw6 -Z "$TSCHAIN" || fail 'IPv6 VPN counter reset failed; other owned counters already reset'
    if tunnel_present; then
      for owned in "$VPNCHAIN" "$TRUSTCHAIN"; do
        fw4 -Z "$owned" || fail 'IPv4 tunnel counter reset failed; other owned counters already reset'
        fw6 -Z "$owned" || fail 'IPv6 tunnel counter reset failed; other owned counters already reset'
      done
    fi
    say 'PocketUFW: owned counters reset; newly arriving packets may already be counted.'
    ;;
  activity|verbose)
    root_needed
    prereqs
    collect_counters || exit $?
    if [ "$CMD" = 'activity' ]; then
      say 'state=ACTIVE'
      say "ipv4_blocked=$blocked4"
      say "ipv6_blocked=$blocked6"
      say "ipv4_blocked_bytes=$bytes4"
      say "ipv6_blocked_bytes=$bytes6"
      say "ipv4_established_replies=$replies4"
      say "ipv6_established_replies=$replies6"
      say "hook_patterns=$IFACES"
      say "tunnel_filter=$TUNNEL_FILTER"
      if [ "$TUNNEL_FILTER" = ON ]; then
        say "tunnel_hooks=$thooks"
        say "ipv4_tunnel_blocked=$tblocked4"
        say "ipv6_tunnel_blocked=$tblocked6"
        say "ipv4_tunnel_blocked_bytes=$tbytes4"
        say "ipv6_tunnel_blocked_bytes=$tbytes6"
        say "ipv4_tunnel_established_replies=$treplies4"
        say "ipv6_tunnel_established_replies=$treplies6"
        say "ipv4_tunnel_trusted=$ttrusted4"
        say "ipv6_tunnel_trusted=$ttrusted6"
      fi
    else
      say 'PocketUFW verbose status'
      say 'Status: ACTIVE (own rules and hooks verified)'
      say 'Incoming: deny unsolicited packets on configured physical interfaces'
      say 'Outgoing: unchanged; Android and VPN policies still apply'
      say "Interface hooks: $IFACES"
      say "IPv4 blocked: $blocked4 packets ($bytes4 bytes)"
      say "IPv6 blocked: $blocked6 packets ($bytes6 bytes)"
      say "IPv4 established/related accepted: $replies4 packets"
      say "IPv6 established/related accepted: $replies6 packets"
      say "Tunnel filter: $TUNNEL_FILTER"
      if [ "$TUNNEL_FILTER" = ON ]; then
        say "Tunnel hooks: $thooks"
        say "Tunnel IPv4 blocked: $tblocked4 packets ($tbytes4 bytes), established $treplies4, allowed $ttrusted4"
        say "Tunnel IPv6 blocked: $tblocked6 packets ($tbytes6 bytes), established $treplies6, allowed $ttrusted6"
      fi
      say 'Counters: kernel rule matches since install or counter reset'
      say 'Limit: preceding Android/OEM rules and other interfaces are not covered by this proof'
    fi
    ;;
  enable)
    root_needed
    prereqs
    if afwall_active; then fail 'AFWall+ is active. Disable its firewall before using this standalone prototype.'; fi
    resolve_tailscale_ports
    if chain_exists4 || chain_exists6 || ts_exists4 || ts_exists6 || tunnel_present; then
      fail 'PocketUFW chain already exists. Run disable before re-enabling.'
    fi
    # Guard against stale hooks with missing chains.
    for iface in $IFACES; do
      if "$IPT4" -w -C INPUT -i "$iface" -m comment --comment PocketUFW -j "$CHAIN" >/dev/null 2>&1 ||
         "$IPT6" -w -C INPUT -i "$iface" -m comment --comment PocketUFW -j "$CHAIN" >/dev/null 2>&1; then
        fail 'Stale PocketUFW hook exists; run disable to clean it up'
      fi
    done
    committed=0
    # On failures before completion, remove only what we created.
    trap 'if [ "$committed" -ne 1 ]; then say "pocketufw: enable failed, cleaning own chains" >&2; cleanup; fi' 0
    build_rules
    hooks_attach
    # Commands succeeding is not enough: if the actual installed policy fails
    # either family's readback audit, roll back before reporting success.
    verify_all ||
      fail 'Post-install verification failed; rolling back own rules'
    committed=1
    trap - 0
    say 'PocketUFW: enabled. Not persistent after reboot.'
    if [ "$PROBE_FAILED" -eq 1 ]; then
      # android-bridge consumes this marker to explain the withheld exception.
      say 'tailscale_probe=FAILED'
      say 'NOTE: Tailscale ports could not be verified; no VPN port exceptions opened. Use refresh later.'
    elif [ "$AUTO_TS" -eq 1 ]; then
      if [ -n "$TS4$TS6" ]; then
        say 'NOTE: Verified Tailscale UDP ports installed. Use refresh after a port change until monitoring is implemented.'
      else
        say 'No verified Tailscale listeners found; no VPN port exceptions opened.'
      fi
    elif [ -n "$TS4$TS6" ] && { [ -z "$TS4" ] || [ -z "$TS6" ]; }; then
      say 'NOTE: Only one Tailscale address-family port was specified.'
    fi
    ;;
  refresh)
    root_needed
    prereqs
    # Refuse any changes unless every owned rule is already in a known state.
    verify_all ||
      fail 'Firewall degraded or disabled; no refresh attempted'
    afwall_active && fail 'AFWall+ active; refresh refused'
    # Detect and validate both families before altering either one.
    AUTO_TS=1
    resolve_tailscale_ports
    old4=$(current_tailscale_port "$IPT4") ||
      fail 'Unrecognized IPv4 VPN exception chain; no changes made'
    old6=$(current_tailscale_port "$IPT6") ||
      fail 'Unrecognized IPv6 VPN exception chain; no changes made'
    # Only report a change when the desired listener ports differ from the
    # ports read from our live child chains. Do not mutate a second time just
    # to determine whether the first refresh changed anything.
    if [ "$old4" = "$TS4" ] && [ "$old6" = "$TS6" ]; then
      refresh_result=UNCHANGED
    else
      refresh_result=UPDATED
    fi
    if ! apply_verified_refresh; then
      fail 'refresh incomplete; inspect status before retrying'
    fi
    verify_all ||
      fail 'Refresh could not be fully verified; inspect rules'
    # This marker is emitted ONLY after a successful transactional refresh.
    # android-bridge consumes it to distinguish updates from no-ops.
    say "refresh_result=$refresh_result"
    say "PocketUFW: Tailscale exceptions refreshed (IPv4: ${TS4:-none}, IPv6: ${TS6:-none})."
    ;;
  get-ports)
    root_needed
    prereqs
    verify_all ||
      fail 'Firewall disabled or degraded; no verified ports available'
    old4=$(current_tailscale_port "$IPT4") || fail 'Unrecognized IPv4 UDP child chain'
    old6=$(current_tailscale_port "$IPT6") || fail 'Unrecognized IPv6 UDP child chain'
    printf 'udp4=%s\nudp6=%s\n' "${old4:-none}" "${old6:-none}"
    ;;
  set-ports)
    root_needed
    prereqs
    # Refuse any changes unless every owned rule is already in a known state.
    verify_all ||
      fail 'Firewall disabled or degraded; no manual changes made'
    afwall_active && fail 'AFWall+ active; manual UDP changes refused'
    old4=$(current_tailscale_port "$IPT4") || fail 'Unrecognized IPv4 UDP child chain'
    old6=$(current_tailscale_port "$IPT6") || fail 'Unrecognized IPv6 UDP child chain'
    if ! apply_verified_refresh; then
      fail 'Manual UDP update incomplete; previous exceptions should be inspected'
    fi
    verify_all ||
      fail 'Manual UDP update could not be fully verified; inspect rules'
    say "PocketUFW: manual UDP exceptions updated, session-only (IPv4: ${TS4:-none}, IPv6: ${TS6:-none})."
    ;;
  disable)
    root_needed
    prereqs
    cleanup
    # Final audit: refuse to claim success if an owned chain remains.
    if chain_exists4 || chain_exists6 || ts_exists4 || ts_exists6 || tunnel_present; then
      fail 'Unable to remove all PocketUFW chains; inspect status'
    fi
    say 'PocketUFW: disabled. Android rules untouched.'
    ;;
  tunnel-plan)
    root_needed
    prereqs
    prepare_tunnel
    DRY_RUN=1
    say '# DRY RUN ONLY - NOTHING EXECUTED'
    install_tunnel_rules
    ;;
  tunnel-on)
    root_needed
    prereqs
    afwall_active && fail 'AFWall+ active; tunnel filter refused'
    tunnel_present && fail 'Tunnel filter already installed. Use tunnel-refresh, or tunnel-off first.'
    # A tunnel filter without the physical policy would be a false impression.
    verify_all || fail 'Firewall disabled or degraded; tunnel filter not installed'
    prepare_tunnel
    committed=0
    trap 'if [ "$committed" -ne 1 ]; then say "pocketufw: tunnel-on failed, removing tunnel rules" >&2; remove_tunnel_family "$IPT4" || :; remove_tunnel_family "$IPT6" || :; fi' 0
    install_tunnel_rules
    verify_all || fail 'Tunnel rules could not be verified; rolling back tunnel rules'
    committed=1
    trap - 0
    say 'tunnel_filter=ON'
    say 'PocketUFW: tunnel filter on until disable, tunnel-off or the next restart.'
    ;;
  tunnel-refresh)
    root_needed
    prereqs
    tunnel_present || fail 'Tunnel filter is off; nothing to refresh'
    verify_all || fail 'Firewall degraded; no refresh attempted'
    read_inventory || fail 'Could not read the current tunnels; nothing changed'
    TUNNEL_NAMES=$(wireguard_names)
    hook_total=1
    for name in $TUNNEL_NAMES; do hook_total=$((hook_total + 1)); done
    [ "$hook_total" -le "$MAX_TUNNEL_HOOKS" ] || fail 'Too many tunnels to hook; nothing changed'
    current_hooks=$(tunnel_hook_names "$IPT4") || fail 'Cannot read tunnel hooks; nothing changed'
    # A tunnel that came up since gets its hook. A hook whose kernel WireGuard is
    # gone goes, so names can't pile up. tun+ always stays.
    for name in $TUNNEL_NAMES; do
      case " $(printf '%s' "$current_hooks" | tr '\n' ' ') " in
        *" $name "*) : ;;
        *) for family_now in 4 6; do
             fwf "$family_now" -A INPUT -i "$name" -m comment --comment "$VPNTAG" -j "$VPNCHAIN" ||
               fail 'Could not add a tunnel hook; inspect tunnel-status'
           done ;;
      esac
    done
    for name in $current_hooks; do
      [ "$name" != 'tun+' ] || continue
      case " $(printf '%s' "$TUNNEL_NAMES" | tr '\n' ' ') " in
        *" $name "*) : ;;
        *) for family_now in 4 6; do
             fwf "$family_now" -D INPUT -i "$name" -m comment --comment "$VPNTAG" -j "$VPNCHAIN" ||
               fail 'Could not remove a tunnel hook; inspect tunnel-status'
           done ;;
      esac
    done
    # Follow Tailscale to its current tun, new rule first. Unproven now means leaving
    # the rule alone: its interface and address no longer match, so it can only be idle.
    if ts_tun=$(tailscale_tun); then
      for family_now in 4 6; do
        if [ "$family_now" = 4 ]; then ipt_now="$IPT4"; else ipt_now="$IPT6"; fi
        trust_now=$(read_trust "$ipt_now" "$family_now") || fail 'Unrecognized allowance chain; inspect tunnel-status'
        [ -n "$trust_now" ] || continue
        own=$(own_tailnet_addr "$family_now" "$ts_tun") || continue
        while read -r t_proto t_peer t_own t_iface t_port; do
          [ -n "$t_proto" ] || continue
          if [ "$t_iface" = "$ts_tun" ] && [ "$t_own" = "$own" ]; then continue; fi
          trust_rule -A "$family_now" "$t_proto" "$t_peer" "$own" "$ts_tun" "$t_port" ||
            fail 'Could not rebind an allowance; inspect tunnel-status'
          trust_rule -D "$family_now" "$t_proto" "$t_peer" "$t_own" "$t_iface" "$t_port" ||
            fail 'Could not remove an old allowance; inspect tunnel-status'
        done <<EOF
$trust_now
EOF
      done
    fi
    verify_all || fail 'Tunnel refresh could not be verified; inspect tunnel-status'
    say 'tunnel_filter=ON'
    ;;
  tunnel-status)
    root_needed
    prereqs
    if ! tunnel_present; then
      say 'tunnel_filter=OFF'
    elif verify_all; then
      say 'tunnel_filter=ON'
    else
      say 'tunnel_filter=DEGRADED'
    fi
    if read_inventory; then
      printf '%s\n' "$INVENTORY" | grep '^tunnel=' || :
      ts_tun=$(tailscale_tun) || ts_tun=''
    else
      say 'inventory=UNAVAILABLE'
      ts_tun=''
    fi
    if tunnel_present; then
      hooks_now=$(tunnel_hook_names "$IPT4" | tr '\n' ',') || hooks_now=''
      say "tunnel_hooks=${hooks_now%,}"
      for family_now in 4 6; do
        if [ "$family_now" = 4 ]; then ipt_now="$IPT4"; else ipt_now="$IPT6"; fi
        trust_now=$(read_trust "$ipt_now" "$family_now") || { say "allowances$family_now=UNREADABLE"; continue; }
        while read -r t_proto t_peer t_own t_iface t_port; do
          [ -n "$t_proto" ] || continue
          binding=STALE
          if [ "$t_iface" = "$ts_tun" ] && [ "$(own_tailnet_addr "$family_now" "$ts_tun")" = "$t_own" ]; then binding=BOUND; fi
          say "allowance=$t_proto:$t_peer:$t_port iface=$t_iface binding=$binding"
        done <<EOF
$trust_now
EOF
      done
    fi
    ;;
  tunnel-off)
    root_needed
    prereqs
    remove_tunnel_family "$IPT4" || :
    remove_tunnel_family "$IPT6" || :
    tunnel_present && fail 'Unable to remove the tunnel rules; inspect status'
    say 'tunnel_filter=OFF'
    say 'PocketUFW: tunnel filter removed. Physical-interface rules untouched.'
    ;;
  residue)
    root_needed
    prereqs
    # Deliberately not built on verify, which only knows what a correct firewall
    # looks like. This reads each whole table for anything still naming PocketUFW,
    # whatever its shape, and can't report zero for a table it couldn't read.
    listing4=$("$IPT4" -w -S) || fail 'Cannot read the IPv4 filter table'
    listing6=$("$IPT6" -w -S) || fail 'Cannot read the IPv6 filter table'
    left4=$(printf '%s\n' "$listing4" | grep -ci pocketufw) || :
    left6=$(printf '%s\n' "$listing6" | grep -ci pocketufw) || :
    say "residue_ipv4=$left4"
    say "residue_ipv6=$left6"
    ;;
esac
