#!/system/bin/sh
# Read-only kernel firewall rules for the optional PocketUFW Status screen.
# This command NEVER edits rules. Report is valid only with a final READY line.
set -eu

[ "$(id -u)" = 0 ] || exit 3

# Filter and bound lines to avoid accidentally returning other Android chains
# or emitting an unbounded report that could stall a UI pipe.
emit_rules() {
  kind="$1"
  fam="$2"
  listing="$3"
  max="$4"
  printf '%s\n' "$listing" | awk -v kind="$kind" -v fam="$fam" -v max="$max" -v n="${5:-0}" '
    BEGIN { label = (kind == "tunnel") ? "main" : kind; start = n }
    $1 == "-A" {
      if (kind == "hook" && !($2 == "INPUT" && /--comment PocketUFW/ &&
                                  (/-j POCKETUFW_IN/ || /-j POCKETUFW_VPN/))) next
      if (kind == "main" && $2 != "POCKETUFW_IN") next
      if (kind == "tunnel" && $2 != "POCKETUFW_VPN") next
      if (kind == "vpn" && $2 != "POCKETUFW_TS") next
      n++
      if (n > max || length($0) > 190) exit 9
      printf "%s%s_%02d=%s\n", label, fam, n, $0
    }
    END { printf "report_%s%s_count=%d\n", kind, fam, n-start }
  '
}

# A hook for tun+ says nothing about a later hook for WireGuard. Compare each
# direct ACCEPT with every relevant hook. Unknown/negated ingress is conservative.
# This does not audit verdicts inside Android/OEM chains; the UI says so explicitly.
emit_bypasses() {
  printf '%s\n' "$input" | awk -v fam="$fam" '
    function covers(a, b) {
      if (a ~ /[+]$/) { sub(/[+]$/, "", a); return index(b, a) == 1 }
      return a == b
    }
    $1 == "-A" && $2 == "INPUT" {
      pos++
      iface = "+"
      for (i = 3; i < NF; i++) if ($i == "-i" && $(i-1) != "!") iface = $(i+1)
      if (NF == 10 && $3 == "-i" && $5 == "-m" && $6 == "comment" && $7 == "--comment" &&
          (($8 == "PocketUFW" && $10 == "POCKETUFW_IN") ||
           ($8 == "PocketUFW-VPN" && $10 == "POCKETUFW_VPN")) && $9 == "-j") hook[pos] = iface
      if ($(NF-1) == "-j" && $NF == "ACCEPT") { rule[pos] = $0; ingress[pos] = iface }
    }
    END {
      for (r = 1; r <= pos; r++) if (r in rule) {
        bypass = 0
        for (h = r+1; h <= pos; h++) if (h in hook) {
          if (!covers(ingress[r], hook[h]) && !covers(hook[h], ingress[r])) continue
          already = 0
          for (p = 1; p < r; p++) if (p in hook &&
              (covers(hook[p], hook[h]) || covers(hook[p], ingress[r]))) already = 1
          if (!already) bypass = 1
        }
        if (bypass) {
          n++
          if (n > 6 || length(rule[r]) > 190) exit 9
          printf "input_bypass%s_%02d=%s\n", fam, n, rule[r]
        }
      }
      printf "report_bypass%s_count=%d\n", fam, n
    }
  '
}

emit_family() {
  fam="$1"
  ipt="$2"

  # All reads must succeed. No special-case or invented default policies.
  input=$("$ipt" -w -S INPUT 2>/dev/null) || return 1
  main=$("$ipt" -w -S POCKETUFW_IN 2>/dev/null) || return 1
  vpn=$("$ipt" -w -S POCKETUFW_TS 2>/dev/null) || return 1

  case "$main" in *'-N POCKETUFW_IN'*) : ;; *) return 1 ;; esac
  case "$vpn" in *'-N POCKETUFW_TS'*) : ;; *) return 1 ;; esac

  # Optional. Once a hook points at it, a chain we can't read makes the report incomplete.
  tunnel=''
  has_tunnel=0
  if tunnel=$("$ipt" -w -S POCKETUFW_VPN 2>/dev/null); then
    has_tunnel=1
  else
    tunnel=''
    case "$input" in *'-j POCKETUFW_VPN'*) return 1 ;; esac
  fi

  policy=$(printf '%s\n' "$input" | awk '$1 == "-P" && $2 == "INPUT" {print $3; exit}')
  case "$policy" in ACCEPT|DROP|REJECT) : ;; *) return 1 ;; esac
  printf 'input_policy%s=%s\n' "$fam" "$policy"
  # An ACCEPT ahead of our hooks is a hole the rule audit cannot see. Android's
  # own chains jump to oem_in, pl_INPUT and so on. With no hook, nothing is bypassed.
  case "$input" in
    *'--comment PocketUFW'*) emit_bypasses || return 1 ;;
    *) printf 'report_bypass%s_count=0\n' "$fam" ;;
  esac
  # Four physical hooks, plus at most MAX_TUNNEL_HOOKS when the tunnel filter is on.
  hook_limit=6
  [ "$has_tunnel" -eq 0 ] || hook_limit=12
  emit_rules hook "$fam" "$input" "$hook_limit" || return 1
  emit_rules main "$fam" "$main" 12 || return 1
  if [ "$has_tunnel" -eq 1 ]; then
    main_lines=$(printf '%s\n' "$main" | grep -c '^-A ') || main_lines=0
    # Include up to two temporary diagnostic probes so an interrupted sample can
    # be recognized by the UI. This is reporting only; engine verification stays strict.
    emit_rules tunnel "$fam" "$tunnel" "$((main_lines + 6))" "$main_lines" || return 1
  else
    printf 'report_tunnel%s_count=0\n' "$fam"
  fi
  emit_rules vpn "$fam" "$vpn" 3 || return 1
}

# The final marker is mandatory: earlier partial output is never a report.
emit_family 4 iptables || exit 4
emit_family 6 ip6tables || exit 4
printf 'rules_report=READY\n'
