#!/bin/sh
# Prepare standalone release assets only; no APK build, installation or upload.
set -eu

if [ "$#" -ne 1 ]; then
    echo 'Usage: tools/package-termux NEW_OUTPUT_DIRECTORY' >&2
    exit 2
fi
case "$1" in ''|-*) echo 'Choose a new output directory.' >&2; exit 2 ;; esac
source_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
output_dir=$1
mkdir -p -- "$(dirname -- "$output_dir")"
# Refuse an existing directory so unrelated release files cannot be overwritten.
mkdir -- "$output_dir"
cp -- "$source_dir/tools/pufw" "$output_dir/pufw"
chmod 755 "$output_dir/pufw"
cp -- "$source_dir/docs/termux.md" "$output_dir/Termux-setup.md"
(cd -- "$output_dir" && sha256sum pufw > pufw.sha256)
printf 'Prepared pufw, pufw.sha256 and Termux-setup.md in %s\nNothing was installed or published.\n' "$output_dir"
