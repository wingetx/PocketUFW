#!/system/bin/sh
# Optional Termux companion. Only existing native read commands are reachable.
set -u

usage() {
    cat <<'HELP'
Usage: pufw [tunnel|stats|raw]
  pufw         Verified rules, tunnel summary and counters
  pufw tunnel  Tunnel mode, saved authorization and current address verification
  pufw stats   Physical/tunnel DROP packets, bytes and established/related returns
  pufw raw     Native inspect output (read-only; no packet sampling)

Requires root and an installed PocketUFW app opened at least once with Recheck.
Optional engine override: PUFW_ENGINE=/absolute/path/to/pocketufw
No changes, background polling or connection tests. See docs/termux.md.
HELP
}
[ "$#" -le 1 ] || { usage >&2; exit 2; }
view=${1:-status}
case "$view" in
    status) [ "$#" -eq 0 ] || { usage >&2; exit 2; }; native=inspect ;;
    stats) native=activity ;;
    tunnel) native=tunnel-status ;;
    raw) native=inspect ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac
engine=${PUFW_ENGINE:-/data/user/0/io.github.pocketufw/files/engine/pocketufw}
# Deliberately constrain this optional path before including it in su -c.
case "$engine" in
    *[!A-Za-z0-9_./-]*|'') echo 'pufw: PUFW_ENGINE must be an absolute path using letters, digits, /, ., _, or -.' >&2; exit 2 ;;
    /*) ;;
    *) echo 'pufw: PUFW_ENGINE must be an absolute path.' >&2; exit 2 ;;
esac
for tool in su timeout awk; do
    command -v "$tool" >/dev/null 2>&1 || { echo "pufw: Required command unavailable: $tool. No inspection performed." >&2; exit 1; }
done

# One root session, one native inspection. No app bridge, extra verify pass,
# or fallback to a different engine copy.
output=$(timeout -s KILL 30 su -c "
    [ \"\$(id -u)\" = 0 ] || { echo 'pufw: Root access was not granted.' >&2; exit 77; }
    [ -f '$engine' ] && [ -r '$engine' ] || {
        echo 'pufw: PocketUFW engine unavailable. Open the installed app and tap Recheck first; check PUFW_ENGINE for another Android user or a standalone installation.' >&2
        exit 66
    }
    exec sh '$engine' '$native'
" 2>&1)
result=$?
case "$result" in
    124|137) echo 'pufw: Inspection timed out. Current state is unknown; try again.' >&2; exit 1 ;;
    66|77) printf '%s\n' "$output" >&2; exit 1 ;;
esac

printf '%s\n' "$output" | awk -v view="$view" -v result="$result" '
function value(key) { return seen[key] == 1 ? data[key] : "" }
function counter(key, v) {
    v = value(key)
    return v ~ /^(0|[1-9][0-9]*)$/ && length(v) <= 20 &&
        (length(v) < 20 || "x" v <= "x18446744073709551615") ? v : ""
}
# Decimal strings avoid shell integer overflow and awk double rounding.
function add(a, b, n, carry, out) {
    if (a == "" || b == "") return ""
    while (length(a) || length(b) || carry) {
        n = substr(a, length(a), 1) + substr(b, length(b), 1) + carry
        out = (n % 10) out; carry = int(n / 10)
        a = substr(a, 1, length(a) - 1); b = substr(b, 1, length(b) - 1)
    }
    return out
}
function grouped(v, out) {
    if (v == "") { incomplete = 1; return "Unavailable" }
    while (length(v) > 3) { out = "," substr(v, length(v) - 2) out; v = substr(v, 1, length(v) - 3) }
    return v out
}
function total(suffix) { return add(counter("ipv4_" suffix), counter("ipv6_" suffix)) }
function completeCounters(    required, n, fields, i) {
    required = "blocked blocked_bytes established_replies"
    if (filter == "ON") required = required " tunnel_blocked tunnel_blocked_bytes tunnel_established_replies tunnel_tailnet"
    n = split(required, fields, " ")
    for (i = 1; i <= n; i++) if (counter("ipv4_" fields[i]) == "" || counter("ipv6_" fields[i]) == "") return 0
    return 1
}
function pin4(v, parts, i) {
    if (split(v, parts, /[.\/]/) != 5 || parts[1] != "100" || parts[2] < 64 || parts[2] > 127 || parts[5] != "32") return 0
    for (i = 1; i <= 4; i++) if (parts[i] !~ /^(0|[1-9][0-9]*)$/ || parts[i] > 255) return 0
    return 1
}
function pin6(v) { return v ~ /^fd7a:115c:a1e0:[0-9a-f:]+\/128$/ }
function authorization(    p4, p6, o4, o6, current) {
    if (mode == "OFF") return "Not configured"
    if (mode == "DENY_ONLY") return "DENY-ONLY; no tailnet exemption"
    if (mode != "PINNED") { incomplete = 1; return "UNVERIFIED" }
    p4 = value("tailnet_pin4"); p6 = value("tailnet_pin6")
    if (!pin4(p4) || !pin6(p6) || value("tailnet_trust") != "PINNED_DESTINATIONS") {
        incomplete = 1; return "UNVERIFIED; saved pins incomplete"
    }
    if (view == "stats") return "Current addresses not checked; use pufw tunnel"
    o4 = value("tailnet_observed4"); o6 = value("tailnet_observed6"); current = value("tailnet_current")
    if (filter != "ON" || probeUnavailable || value("tailnet_wireguard") != "NONE_OBSERVED" || value("inventory") == "UNAVAILABLE" ||
        !pin4(o4) || !pin6(o6)) { incomplete = 1; return "UNVERIFIED; saved pins are not current address proof" }
    if (current == "MATCH" && p4 == o4 && p6 == o6) return "MATCH; addresses verified in this inspection (reachability not tested)"
    if (current == "REAUTHORIZE" && (p4 != o4 || p6 != o6)) {
        attention = 1; return "REAUTHORIZE; addresses changed, installed rules unchanged. Review PINNED in Settings."
    }
    incomplete = 1; return "UNVERIFIED; recheck with pufw tunnel"
}
{
    raw = raw $0 "\n"; last = $0
    # tunnel-status can finish normally with OFF or unverified address evidence.
    # This specific probe diagnostic is not a failed rule inspection, but it
    # always vetoes a current-address claim. Other unexpected text stays invalid.
    if ($0 == "vpn-probe: one verified Tailscale tun with both node addresses is required") { probeUnavailable = 1; next }
    if ($0 !~ /^[a-z0-9_]+=/ || $0 ~ /[[:cntrl:]]/) { bad = 1; next }
    pos = index($0, "="); key = substr($0, 1, pos - 1)
    if (++seen[key] > 1 && key != "tunnel" && key != "tailnet") bad = 1
    data[key] = substr($0, pos + 1)
}
END {
    state = value("state"); filter = value("tunnel_filter"); mode = value("tunnel_mode")
    if (view == "stats") {
        if (state == "ACTIVE" && result == 0) {
            physical = "ACTIVE"
            if (filter == "OFF") mode = "OFF"
            # activity has no completion marker: require its full counter set.
            if (!completeCounters()) bad = 1
        } else if (state == "INACTIVE" && result == 3) { physical = "INACTIVE"; filter = mode = "OFF" }
        else if (state == "DEGRADED" && result == 4) { physical = filter = mode = "UNKNOWN" }
        else bad = 1
    } else if (view == "tunnel") {
        if (result != 0 || last != "tunnel_status=READY") bad = 1
    } else {
        physical = value("physical_state")
        if (result != 0 || last != "inspection=READY" || state !~ /^(ACTIVE|INACTIVE|DEGRADED)$/ ||
            physical !~ /^(ACTIVE|INACTIVE|DEGRADED|UNKNOWN)$/ || (state == "ACTIVE" && physical != "ACTIVE")) bad = 1
    }
    if (state != "DEGRADED" || view != "stats") {
        if (filter !~ /^(ON|OFF|DEGRADED)$/ || mode !~ /^(PINNED|DENY_ONLY|OFF|UNKNOWN)$/ ||
            (filter == "OFF" && mode != "OFF") || (filter == "ON" && mode !~ /^(PINNED|DENY_ONLY)$/)) bad = 1
        if (state == "ACTIVE" && filter == "DEGRADED") bad = 1
        if (state == "INACTIVE" && (physical != "INACTIVE" || filter != "OFF")) bad = 1
    }
    if (view == "raw") printf "%s", raw
    if (bad) {
        if (view != "raw") print "PocketUFW UNKNOWN\nInspection failed or incomplete; no current status or counters claimed."
        print "pufw: Could not verify the native response (exit " result "). Check root access and run pufw raw for diagnostics." > "/dev/stderr"
        exit 1
    }
    auth = authorization()
    if (state == "ACTIVE" && view != "tunnel" && !completeCounters()) incomplete = 1
    if (view == "raw") {
        if (incomplete) print "pufw: Native output contains unavailable measurements or unverified authorization." > "/dev/stderr"
        exit (state == "DEGRADED" || filter == "DEGRADED" || incomplete || attention ? 1 : 0)
    }
    if (view == "tunnel") print "PocketUFW tunnel diagnostics"
    else {
        print "● PocketUFW " state
        print "Physical: " (physical == "ACTIVE" ? "Rules verified" : physical == "INACTIVE" ? "Inactive" : physical == "DEGRADED" ? "Degraded" : "Not verified")
    }
    print "Tunnel: " (filter == "OFF" ? "OFF (optional)" : filter == "ON" ? (mode == "DENY_ONLY" ? "DENY-ONLY" : mode) " (rules verified)" : filter == "DEGRADED" ? "DEGRADED / full ruleset not verified" : "Not verified")
    print "Authorization: " auth
    if (view == "tunnel") {
        if (mode == "PINNED") {
            print "Saved destinations: " (pin4(value("tailnet_pin4")) ? value("tailnet_pin4") : "Unavailable") ", " (pin6(value("tailnet_pin6")) ? value("tailnet_pin6") : "Unavailable")
            print "Observed addresses: " (pin4(value("tailnet_observed4")) ? value("tailnet_observed4") : "Unavailable") ", " (pin6(value("tailnet_observed6")) ? value("tailnet_observed6") : "Unavailable")
            print "PINNED trusts addresses, not individual packets or ingress interface ownership."
        }
        print "Session only; tunnel filtering never restores after reboot."
    } else {
        print "Coverage: " (physical == "ACTIVE" ? "Filtered where supported" : physical == "INACTIVE" ? "Inactive" : "Not verified")
        print ""
        if (state != "ACTIVE") print "Counters: Unavailable (protection " state "; no measurements claimed)"
        else {
            print "Physical drops: " grouped(total("blocked")) " packets" (view == "stats" ? " / " grouped(total("blocked_bytes")) " bytes" : "")
            print "Physical return traffic: " grouped(total("established_replies")) " packets"
            if (filter == "ON") {
                print "Tunnel drops: " grouped(total("tunnel_blocked")) " packets" (view == "stats" ? " / " grouped(total("tunnel_blocked_bytes")) " bytes" : "")
                print "Tunnel return traffic: " grouped(total("tunnel_established_replies")) " packets"
            } else print "Tunnel counters: Not installed (not zero)"
        }
        print "Return traffic = established/related rule matches, not all device traffic."
    }
    print "At this inspection only. Earlier Android rules and unsupported interfaces can bypass filtering."
    if (incomplete) print "pufw: Some details are unavailable or unverified; recheck before relying on them." > "/dev/stderr"
    exit (state == "DEGRADED" || filter == "DEGRADED" || incomplete || attention ? 1 : 0)
}'
