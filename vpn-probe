#!/system/bin/sh
# PocketUFW VPN listener probe, v0.1-dev.
# Read-only: identifies verified Tailscale Android UDP listener ports.
# Never opens ports or modifies kernel rules.
set -eu

SS_BIN="${POCKETUFW_SS_BIN:-ss}"
PROC_ROOT="${POCKETUFW_PROC_ROOT:-/proc}"
PACKAGES_LIST="${POCKETUFW_PACKAGES_LIST:-/data/system/packages.list}"
SYS_NET="${POCKETUFW_SYS_NET:-/sys/class/net}"

usage() {
    cat <<'HELP'
Usage: sh vpn-probe [--help | tunnels | tailscale-addresses | tunnel-details | android-vpn]

Read-only Android Tailscale UDP listener discovery. Requires root.
Prints tailscale_udp4=PORT and tailscale_udp6=PORT when each listener is
verified using ss process metadata, /proc/PID/cmdline and the process UID,
which must belong to Tailscale's package.
An empty value means no verified listener for that address family.
No firewall rules are changed. Does not monitor subsequent port changes.

tunnels prints one tunnel=NAME kind=tun|wireguard owner=PACKAGE|kernel|unknown
proof=verified|android-only|kernel-type|none line per tunnel, then
inventory=COMPLETE. An app's tun is verified only when Android's VPN record and the
kernel agree: a process of that package holds /dev/tun for exactly that interface.
tailscale-addresses requires one such Tailscale tun, with both node addresses.
It authorizes exact /32 and /128 destinations only; it does not authenticate packets.
tunnel-details combines inventory and address proof in one observation for callers;
unavailable proof is authorization=UNVERIFIED, followed by tunnel_details=COMPLETE.
android-vpn reads advisory owner/interface display metadata without authorizing trust.
HELP
}
case "${1:-}" in
    --help|-h) usage; exit 0 ;;
    ''|tunnels|tailscale-addresses|tunnel-details|android-vpn) ;;
    stale-ports) [ "$#" -eq 3 ] || exit 2 ;;
    *) echo "vpn-probe: unknown argument: $1" >&2; exit 2 ;;
esac
if [ "$#" -gt 1 ] && [ "$1" != stale-ports ]; then
    echo "vpn-probe: too many arguments" >&2
    exit 2
fi

[ "$(id -u)" -eq 0 ] || { echo "vpn-probe: root needed to verify socket ownership" >&2; exit 3; }

# Android's record of which package owns which VPN interface, as "IFACE PACKAGE".
# Dumpsys output varies by release, so absence only means Android makes no claim.
android_claims() {
    command -v dumpsys >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1 || return 0
    # Streamed: Android's printf is an external command, and this output is too large
    # to pass to one. awk with index(): a two-part .* regex takes 18 s on these long lines.
    # Stay in the enclosing probe deadline's process group, including the second scan.
    { timeout --foreground -k 1 5 dumpsys connectivity 2>/dev/null && echo 'POCKETUFW_DUMPSYS_COMPLETE'; } | awk '
      $0 == "POCKETUFW_DUMPSYS_COMPLETE" { complete = 1; next }
      /ni{VPN CONNECTED/ {
        from = index($0, "ni{VPN CONNECTED extra: VPN:")
        at = index($0, "InterfaceName: ")
        if (!from) next
        package = substr($0, from + 28); package = substr(package, 1, index(package, "}") - 1)
        if (package !~ /^[A-Za-z0-9_.-]+$/) package = "?"
        iface = "-"
        if (at) {
          iface = substr($0, at + 15)
          stop = index(iface, " "); brace = index(iface, "}")
          if (!stop || (brace && brace < stop)) stop = brace
          if (stop) iface = substr(iface, 1, stop - 1)
          if (iface !~ /^[A-Za-z0-9_.-]+$/) iface = "-"
        }
        claims[iface " " package] = 1
      }
      END { if (!complete) exit 1; for (claim in claims) print claim }
    '
}

# Advisory display metadata from the SAME compact Android observation. This is
# not the UID/fd ownership proof used to authorize addresses. Ambiguity stays blank.
android_summary() {
    printf '%s\n' "$claims" | awk '
      NF == 2 { owners[$2] = 1; ifaces[$1] = 1 }
      END {
        for (p in owners) { owner = p; n++ }
        for (i in ifaces) { iface = i; m++ }
        if (n != 1 || owner !~ /^[A-Za-z0-9_.-]+$/) owner = ""
        if (owner == "" || m != 1 || iface == "-") iface = ""
        print "vpn_owner=" owner; print "vpn_iface=" iface
      }
    '
}
if [ "${1:-}" = android-vpn ]; then
    claims=$(android_claims) || claims=''
    android_summary
    echo 'android_vpn=COMPLETE'
    exit 0
fi

# The kernel's answer, which an app can't influence: a process running under that
# package's app ID holds /dev/tun, and fdinfo names exactly this interface. Bounded
# to that app's processes: walking every descriptor on a phone takes minutes.
package_holds_tun() {
    want_appid=$(awk -v p="$1" '$1 == p { print $2; exit }' "$PACKAGES_LIST" 2>/dev/null) || want_appid=''
    case "$want_appid" in ''|*[!0-9]*) return 1 ;; esac
    # A process UID is user ID x 100000 + app ID, so this also fits other users.
    pids=$(grep -H '^Uid:' "$PROC_ROOT"/[0-9]*/status 2>/dev/null | awk -v id="$want_appid" '{
        split($0, f, /[: \t]+/); path = f[1]; sub(/\/status$/, "", path); sub(/.*\//, "", path)
        if (f[3] ~ /^[0-9]+$/ && f[3] % 100000 == id) print path
    }') || pids=''
    for pid in $pids; do
        fds=$(ls -l "$PROC_ROOT/$pid/fd" 2>/dev/null |
            awk '$NF ~ /^\/dev\/(net\/)?tun$/ { print $(NF-2) }') || fds=''
        for fd in $fds; do
            case "$fd" in *[!0-9]*) continue ;; esac
            if awk -v want="$2" '$1 == "iff:" && $2 == want { found = 1 } END { exit !found }' \
                "$PROC_ROOT/$pid/fdinfo/$fd" 2>/dev/null; then
                return 0
            fi
        done
    done
    return 1
}

# Names say nothing: Android numbers tun devices as it pleases, and a kernel WireGuard
# can be called anything. Kinds below come from the kernel. A device that is neither
# isn't listed, which keeps carrier ipsec and clat out of any tunnel decision.
tunnel_inventory() {
    [ -d "$SYS_NET" ] || { echo "vpn-probe: $SYS_NET unavailable" >&2; exit 4; }
    claims=$(android_claims) || claims=''
    [ "${1:-}" != display ] || android_summary
    for device in "$SYS_NET"/*; do
        name=${device##*/}
        case "$name" in ''|*[!A-Za-z0-9_.-]*|lo|wlan*|rmnet*|v4-rmnet*) continue ;; esac
        if grep -qx 'DEVTYPE=wireguard' "$device/uevent" 2>/dev/null; then
            kind=wireguard
        elif [ -e "$device/tun_flags" ]; then
            flags=$(cat "$device/tun_flags" 2>/dev/null) || flags=''
            case "$flags" in 0x*) : ;; *) continue ;; esac
            case "${flags#0x}" in ''|*[!0-9a-fA-F]*) continue ;; esac
            # IFF_TUN, not a tap device.
            [ "$((flags & 1))" -eq 1 ] || continue
            kind=tun
        else
            continue
        fi
        owners=$(printf '%s\n' "$claims" | awk -v want="$name" '$1 == want { print $2 }')
        case "$owners" in
            ''|*[!A-Za-z0-9_.-]*) owner='' ;; # None, or conflicting claims: no owner.
            *) owner=$owners ;;
        esac
        if [ "$kind" = wireguard ]; then
            proof=kernel-type
            owner=${owner:-kernel}
        elif [ -z "$owner" ]; then
            proof=none
            owner=unknown
        elif package_holds_tun "$owner" "$name"; then
            proof=verified
        else
            proof=android-only
        fi
        printf 'tunnel=%s kind=%s owner=%s proof=%s\n' "$name" "$kind" "$owner" "$proof"
    done
    echo 'inventory=COMPLETE'
}
if [ "${1:-}" = tunnels ]; then
    tunnel_inventory
    exit 0
fi

# Initial authorization only. Never recover addresses from routes, another VPN,
# previous output or a whole tailnet range. Recheck ownership and interface identity
# around the address read; these are snapshots, not a lasting ingress guarantee.
authorize_addresses() {
    authorization_failure() { echo 'vpn-probe: one verified Tailscale tun with both node addresses is required' >&2; exit 4; }
    auth_iface=$(printf '%s\n' "$inventory" | sed -n 's/^tunnel=\([^ ]*\) kind=tun owner=com.tailscale.ipn proof=verified$/\1/p')
    case "$auth_iface" in tun*) ;; *) authorization_failure ;; esac
    case "$auth_iface" in *[!A-Za-z0-9_.-]*) authorization_failure ;; esac
    [ "${#auth_iface}" -le 15 ] || authorization_failure
    # A kernel WireGuard named tun* would share the wildcard exemption.
    if printf '%s\n' "$inventory" | grep -q '^tunnel=tun[^ ]* kind=wireguard '; then authorization_failure; fi
    auth_index=$(cat "$SYS_NET/$auth_iface/ifindex") || authorization_failure
    case "$auth_index" in ''|*[!0-9]*) authorization_failure ;; esac
    auth_addresses=$(ip -o addr show dev "$auth_iface" scope global) || authorization_failure
    auth_pins=$(printf '%s\n' "$auth_addresses" | awk '
      $3 == "inet" && $4 ~ /^100\./ {
        n = split($4, a, /[.\/]/)
        if (n != 5 || a[1] != "100" || a[5] != "32") exit 1
        for (i = 1; i <= 4; i++) if (a[i] !~ /^[0-9]+$/ || a[i] > 255 || (length(a[i]) > 1 && a[i] ~ /^0/)) exit 1
        if (a[2] < 64 || a[2] > 127 || / tentative | dadfailed /) exit 1
        four = $4; count4++
      }
      $3 == "inet6" && tolower($4) ~ /^fd7a:115c:a1e0:/ {
        if (tolower($4) !~ /^fd7a:115c:a1e0:[0-9a-f:]+\/128$/ || / tentative | dadfailed /) exit 1
        six = tolower($4); count6++
      }
      END {
        if (count4 != 1 || count6 != 1) exit 1
        print "tailnet_pin4=" four; print "tailnet_pin6=" six
      }
    ') || authorization_failure
    [ "$(cat "$SYS_NET/$auth_iface/ifindex")" = "$auth_index" ] || authorization_failure
    [ -e "$SYS_NET/$auth_iface/tun_flags" ] || authorization_failure
    grep -q '^DEVTYPE=wireguard$' "$SYS_NET/$auth_iface/uevent" && authorization_failure
    package_holds_tun com.tailscale.ipn "$auth_iface" || authorization_failure
    [ "$(android_claims | awk -v name="$auth_iface" '$1 == name { print $2 }')" = com.tailscale.ipn ] || authorization_failure
    auth_recheck=$(ip -o addr show dev "$auth_iface" scope global) || authorization_failure
    [ "$auth_recheck" = "$auth_addresses" ] || authorization_failure
    auth_index_now=$(cat "$SYS_NET/$auth_iface/ifindex") || authorization_failure
    [ "$auth_index_now" = "$auth_index" ] || authorization_failure
    printf '%s\ntailnet_iface=%s\nauthorization=VERIFIED\n' "$auth_pins" "$auth_iface"
}
case "${1:-}" in
    tailscale-addresses|tunnel-details)
        inventory=$(tunnel_inventory display) || exit 4
        if [ "$1" = tailscale-addresses ]; then authorize_addresses; exit $?; fi
        printf '%s\n' "$inventory"
        if address_proof=$(authorize_addresses); then printf '%s\n' "$address_proof"
        else echo 'authorization=UNVERIFIED'; fi
        echo 'tunnel_details=COMPLETE'
        exit 0 ;;
esac
command -v "$SS_BIN" >/dev/null 2>&1 || { echo "vpn-probe: ss utility unavailable" >&2; exit 4; }
[ -d "$PROC_ROOT" ] || { echo "vpn-probe: /proc unavailable" >&2; exit 4; }

# Android gives each package its own app ID. Unlike a process name or cmdline,
# which any app can set with android:process, an app cannot choose its UID.
# Read packages.list, not the package's data directory: su from the app inherits
# the app's mount namespace, where data isolation hides other apps' directories.
ts_appid=$(awk '$1 == "com.tailscale.ipn" { print $2; exit }' "$PACKAGES_LIST" 2>/dev/null) || ts_appid=''
case "$ts_appid" in *[!0-9]*) ts_appid='' ;; esac


validate_port() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# Only used after an explicit refresh failed. Inspect all UDP sockets (including
# connected ones), not just discoverable listeners. Missing metadata means unknown,
# never permission to close a possibly live Tailscale socket. This opens no ports.
stale_port() {
    wanted="$2"
    [ "$wanted" != none ] || { echo no; return; }
    validate_port "$wanted" || return 2
    [ -n "$ts_appid" ] || { echo unknown; return; }
    # A dual-stack IPv6 socket can also serve IPv4. A Tailscale socket at this
    # port in either family prevents retirement; never infer IPV6_V6ONLY from ss.
    sockets4=$("$SS_BIN" -H -u -a -n -p -4 2>/dev/null) || { echo unknown; return; }
    sockets6=$("$SS_BIN" -H -u -a -n -p -6 2>/dev/null) || { echo unknown; return; }
    sockets="$sockets4
$sockets6"
    stale=yes
    while IFS= read -r socket; do
        [ -n "$socket" ] || continue
        address=$(printf '%s\n' "$socket" | awk '{print $4}')
        validate_port "${address##*:}" || { stale=unknown; continue; }
        [ "${address##*:}" = "$wanted" ] || continue
        owners=$(printf '%s\n' "$socket" | grep -o 'pid=[0-9][0-9]*' | sed 's/pid=//g') || owners=''
        [ -n "$owners" ] || stale=unknown
        for owner_pid in $owners; do
            owner_uid=$(awk '$1 == "Uid:" {print $2; exit}' "$PROC_ROOT/$owner_pid/status" 2>/dev/null) || owner_uid=''
            case "$owner_uid" in ''|*[!0-9]*) stale=unknown; continue ;; esac
            # Same package, even a differently named process: keep it conservatively.
            if [ "$((owner_uid % 100000))" = "$ts_appid" ]; then echo no; return; fi
        done
    done <<EOF
$sockets
EOF
    echo "$stale"
}
if [ "${1:-}" = stale-ports ]; then
    stale4=$(stale_port 4 "$2") || exit $?
    stale6=$(stale_port 6 "$3") || exit $?
    printf 'stale_udp4=%s\nstale_udp6=%s\n' "$stale4" "$stale6"
    exit 0
fi

scan() {
    family="$1"
    # Use separate socket families; never guess IPv6 from 0.0.0.0 or *.
    if ! listing=$("$SS_BIN" -H -u -l -n -p "-$family" 2>/dev/null); then
        echo "vpn-probe: ss IPv$family lookup unavailable" >&2
        return 5
    fi
    matched=''
    saw_unverified=0
    while IFS= read -r line; do
        case "$line" in
            *tailscale.ipn*) ;;
            *) continue ;;
        esac
        # Process name in ss can be truncated to 15 characters.
        pid=$(printf '%s\n' "$line" | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p')
        case "$pid" in
            ''|*[!0-9]*) saw_unverified=1; continue ;;
        esac
        # Validate against the full Android package process name.
        # Do not trust the truncated ss label by itself.
        if [ ! -r "$PROC_ROOT/$pid/cmdline" ]; then
            saw_unverified=1
            continue
        fi
        app=$(tr '\000' '\n' < "$PROC_ROOT/$pid/cmdline" | head -n 1)
        [ "$app" = 'com.tailscale.ipn' ] || { saw_unverified=1; continue; }
        # First field of Uid: is the real UID. Name and cmdline prove nothing alone.
        proc_uid=$(awk '$1 == "Uid:" { print $2; exit }' "$PROC_ROOT/$pid/status" 2>/dev/null) || proc_uid=''
        case "$proc_uid" in ''|*[!0-9]*) saw_unverified=1; continue ;; esac
        # A process UID is user ID x 100000 + app ID, so this also fits other users.
        [ -n "$ts_appid" ] && [ "$((proc_uid % 100000))" = "$ts_appid" ] || { saw_unverified=1; continue; }
        socket_addr=$(printf '%s\n' "$line" | awk '{print $4}')
        port=${socket_addr##*:}
        validate_port "$port" || { saw_unverified=1; continue; }
        if [ -n "$matched" ] && [ "$matched" != "$port" ]; then
            echo "vpn-probe: ambiguous IPv$family Tailscale UDP ports; refusing to choose" >&2
            return 6
        fi
        matched="$port"
    done <<EOF
$listing
EOF
    if [ "$saw_unverified" -ne 0 ]; then
        echo "vpn-probe: IPv$family had unverified Tailscale-looking sockets; refusing automatic exception" >&2
        return 7
    fi
    printf '%s\n' "$matched"
}

udp4=$(scan 4) || exit $?
udp6=$(scan 6) || exit $?
# If the app is running but socket ownership is not visible, do not pretend
# that no exception is needed. The user can retry or choose manual ports.
if [ -z "$udp4$udp6" ] && command -v pidof >/dev/null 2>&1; then
    running=$(pidof com.tailscale.ipn 2>/dev/null || true)
    if [ -n "$running" ]; then
        echo 'vpn-probe: Tailscale running, but no verified UDP sockets found' >&2
        exit 8
    fi
fi
printf 'tailscale_udp4=%s\n' "$udp4"
printf 'tailscale_udp6=%s\n' "$udp6"
